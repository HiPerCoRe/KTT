// C++ kernel for tiled matrix transposition with OpenMP parallelization
// Signature matches void (*)(void**, size_t*)
// buffers[0] = output float* (transposed matrix)
// buffers[1] = input float* (original matrix)
// sizes[0] = matrix width (number of columns)
// sizes[1] = matrix height (number of rows)
#include <cstddef>

// TILE_SIZE is defined via compiler flags from tuning parameter
#ifndef TILE_SIZE
#define TILE_SIZE 16
#endif

#define STRINGIFY(x) #x
#define EXPAND_AND_STRINGIFY(x) STRINGIFY(x)

#define DO_PRAGMA(x) _Pragma(#x)

extern "C" void transpose(void** buffers, size_t* sizes) {
    // sizes array layout: [output_buffer_size, input_buffer_size, width, height]
    size_t width = sizes[2];
    size_t height = sizes[3];
    float* output = static_cast<float*>(buffers[0]);
    const float* input = static_cast<const float*>(buffers[1]);
    
    // Calculate number of tiles in each dimension
    size_t tileCountX = (width + TILE_SIZE - 1) / TILE_SIZE;
    size_t tileCountY = (height + TILE_SIZE - 1) / TILE_SIZE;
    
    // Parallelize over tiles using OpenMP
    // Each thread processes a subset of tiles
#if OMP_COLLAPSE == 0
  #if OMP_SCHEDULING == 0
  #pragma omp parallel for schedule(static)
  #elif OMP_SCHEDULING == 1
  #pragma omp parallel for schedule(dynamic)
  #else // OMP_SCHEDULING
  DO_PRAGMA(message("omp parallel for schedule(guided, " EXPAND_AND_STRINGIFY(OMP_SCHED_CHUNK) ")"))
  #endif // OMP_SCHEDULING
#else // OMP_COLLAPSE
  #if OMP_SCHEDULING == 0
  #pragma omp parallel for collapse(2) schedule(static)
  #elif OMP_SCHEDULING == 1
  #pragma omp parallel for collapse(2) schedule(dynamic)
  #else // OMP_SCHEDULING
  DO_PRAGMA(message("omp parallel for collapse(2) schedule(guided, " EXPAND_AND_STRINGIFY(OMP_SCHED_CHUNK) ")"))
  #endif // OMP_SCHEDULING
#endif
    for (size_t tileY = 0; tileY < tileCountY; ++tileY) {
        for (size_t tileX = 0; tileX < tileCountX; ++tileX) {
            // Process elements within this tile
            for (size_t y = 0; y < TILE_SIZE; ++y) {
                for (size_t x = 0; x < TILE_SIZE; ++x) {
                    // Calculate global coordinates
                    size_t globalX = tileX * TILE_SIZE + x;
                    size_t globalY = tileY * TILE_SIZE + y;
                    
                    // Check bounds
                    if (globalX < width && globalY < height) {
                        // Transpose: output[y][x] = input[x][y]
                        // Linear index: output[globalY * width + globalX] = input[globalY * width + globalX]
                        // After transpose: output[globalX * height + globalY] = input[globalY * width + globalX]
                        output[globalX * height + globalY] = input[globalY * width + globalX];
                    }
                }
            }
        }
    }
}
