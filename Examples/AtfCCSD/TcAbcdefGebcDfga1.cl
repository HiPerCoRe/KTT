#define K1_RES_G_BUFFER(i, j, k, l, m, n, o, p, q) K1_RES_G_BUFFER_NAME()[(i) * K1_G_CB_SIZE_L_2 * K1_G_CB_SIZE_L_3 * K1_G_CB_SIZE_L_4 * K1_G_CB_SIZE_L_5 * K1_G_CB_SIZE_L_6 + (j) * K1_G_CB_SIZE_L_3 * K1_G_CB_SIZE_L_4 * K1_G_CB_SIZE_L_5 * K1_G_CB_SIZE_L_6 + (k) * K1_G_CB_SIZE_L_4 * K1_G_CB_SIZE_L_5 * K1_G_CB_SIZE_L_6 + (l) * K1_G_CB_SIZE_L_5 * K1_G_CB_SIZE_L_6 + (m) * K1_G_CB_SIZE_L_6 + (n)]
#else
