#define K1_P_NUM_EXTRA_ELEMENTS_L_1 ((GET_LOCAL_SIZE_L_1 * K1_L_NUM_CACHED_ITERATIONS_L_1) % (GET_LOCAL_SIZE_L_1 * K1_P_NUM_CACHED_ITERATIONS_L_1) % GET_LOCAL_SIZE_L_1)

