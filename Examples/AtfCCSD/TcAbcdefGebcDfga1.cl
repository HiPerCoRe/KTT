                              const size_t BUFFER_A_INDEX_0(p_index_l_2, p_index_l_3, p_index_l_5, p_index_r_1) = flat_index % BUFFER_A_INDEX_0(K1_P_NUM_PROCESSED_ELEMENTS_L_2, K1_P_NUM_PROCESSED_ELEMENTS_L_3, K1_P_NUM_PROCESSED_ELEMENTS_L_5, K1_P_NUM_PROCESSED_ELEMENTS_R_1);
                              #else
                              const size_t p_index_r_1 = flat_index / (K1_P_NUM_PROCESSED_ELEMENTS_L_5 * K1_P_NUM_PROCESSED_ELEMENTS_L_2 * K1_P_NUM_PROCESSED_ELEMENTS_L_3);
                              const size_t p_index_l_5 = (flat_index / (K1_P_NUM_PROCESSED_ELEMENTS_L_2 * K1_P_NUM_PROCESSED_ELEMENTS_L_3)) % K1_P_NUM_PROCESSED_ELEMENTS_L_5;
                              const size_t p_index_l_2 = (flat_index / (K1_P_NUM_PROCESSED_ELEMENTS_L_3)) % K1_P_NUM_PROCESSED_ELEMENTS_L_2;
                              const size_t p_index_l_3 = flat_index % K1_P_NUM_PROCESSED_ELEMENTS_L_3;
                              #endif
                              K1_P_MEM_A(0, p_index_l_2, p_index_l_3, 0, p_index_l_5, 0, p_index_r_1) = K1_L_MEM_A(K1_P_TO_L_INDEX_L_1(0), K1_P_TO_L_INDEX_L_2(p_index_l_2), K1_P_TO_L_INDEX_L_3(p_index_l_3), K1_P_TO_L_INDEX_L_4(0), K1_P_TO_L_INDEX_L_5(p_index_l_5), K1_P_TO_L_INDEX_L_6(0), K1_P_TO_L_INDEX_R_1(p_index_r_1));
                            }
                            #endif
                            #if (K1_P_NUM_PROCESSED_ELEMENTS_L_4 * K1_P_NUM_PROCESSED_ELEMENTS_L_6 * K1_P_NUM_PROCESSED_ELEMENTS_R_1 * K1_P_NUM_PROCESSED_ELEMENTS_L_1) / K1_P_FLAT_NUM_WI > 0
                            for (size_t step = 0; step < (K1_P_NUM_PROCESSED_ELEMENTS_L_4 * K1_P_NUM_PROCESSED_ELEMENTS_L_6 * K1_P_NUM_PROCESSED_ELEMENTS_R_1 * K1_P_NUM_PROCESSED_ELEMENTS_L_1) / K1_P_FLAT_NUM_WI; ++step) {
                              const size_t flat_index = K1_P_FLAT_WI_ID + step * K1_P_FLAT_NUM_WI;
                              #if CACHE_L_CB != 0
                              const size_t BUFFER_B_INDEX_3(p_index_l_1, p_index_l_4, p_index_l_6, p_index_r_1) = flat_index / (BUFFER_B_INDEX_2(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1) * BUFFER_B_INDEX_1(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1) * BUFFER_B_INDEX_0(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1));
                              const size_t BUFFER_B_INDEX_2(p_index_l_1, p_index_l_4, p_index_l_6, p_index_r_1) = (flat_index / (BUFFER_B_INDEX_1(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1) * BUFFER_B_INDEX_0(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1))) % BUFFER_B_INDEX_2(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1);
                              const size_t BUFFER_B_INDEX_1(p_index_l_1, p_index_l_4, p_index_l_6, p_index_r_1) = (flat_index / (BUFFER_B_INDEX_0(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1))) % BUFFER_B_INDEX_1(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1);
                              const size_t BUFFER_B_INDEX_0(p_index_l_1, p_index_l_4, p_index_l_6, p_index_r_1) = flat_index % BUFFER_B_INDEX_0(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1);
                              #else
                              const size_t p_index_l_4 = flat_index / (K1_P_NUM_PROCESSED_ELEMENTS_L_6 * K1_P_NUM_PROCESSED_ELEMENTS_R_1 * K1_P_NUM_PROCESSED_ELEMENTS_L_1);
                              const size_t p_index_l_6 = (flat_index / (K1_P_NUM_PROCESSED_ELEMENTS_R_1 * K1_P_NUM_PROCESSED_ELEMENTS_L_1)) % K1_P_NUM_PROCESSED_ELEMENTS_L_6;
                              const size_t p_index_r_1 = (flat_index / (K1_P_NUM_PROCESSED_ELEMENTS_L_1)) % K1_P_NUM_PROCESSED_ELEMENTS_R_1;
                              const size_t p_index_l_1 = flat_index % K1_P_NUM_PROCESSED_ELEMENTS_L_1;
                              #endif
                              K1_P_MEM_B(p_index_l_1, 0, 0, p_index_l_4, 0, p_index_l_6, p_index_r_1) = K1_L_MEM_B(K1_P_TO_L_INDEX_L_1(p_index_l_1), K1_P_TO_L_INDEX_L_2(0), K1_P_TO_L_INDEX_L_3(0), K1_P_TO_L_INDEX_L_4(p_index_l_4), K1_P_TO_L_INDEX_L_5(0), K1_P_TO_L_INDEX_L_6(p_index_l_6), K1_P_TO_L_INDEX_R_1(p_index_r_1));
                            }
                            #endif
                            #if (K1_P_NUM_PROCESSED_ELEMENTS_L_4 * K1_P_NUM_PROCESSED_ELEMENTS_L_6 * K1_P_NUM_PROCESSED_ELEMENTS_R_1 * K1_P_NUM_PROCESSED_ELEMENTS_L_1) % K1_P_FLAT_NUM_WI > 0
                            if (K1_P_FLAT_WI_ID < (K1_P_NUM_PROCESSED_ELEMENTS_L_4 * K1_P_NUM_PROCESSED_ELEMENTS_L_6 * K1_P_NUM_PROCESSED_ELEMENTS_R_1 * K1_P_NUM_PROCESSED_ELEMENTS_L_1) % K1_P_FLAT_NUM_WI) {
                              const size_t flat_index = K1_P_FLAT_WI_ID + ((K1_P_NUM_PROCESSED_ELEMENTS_L_4 * K1_P_NUM_PROCESSED_ELEMENTS_L_6 * K1_P_NUM_PROCESSED_ELEMENTS_R_1 * K1_P_NUM_PROCESSED_ELEMENTS_L_1) / K1_P_FLAT_NUM_WI) * K1_P_FLAT_NUM_WI;
                              #if CACHE_L_CB != 0
                              const size_t BUFFER_B_INDEX_3(p_index_l_1, p_index_l_4, p_index_l_6, p_index_r_1) = flat_index / (BUFFER_B_INDEX_2(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1) * BUFFER_B_INDEX_1(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1) * BUFFER_B_INDEX_0(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1));
                              const size_t BUFFER_B_INDEX_2(p_index_l_1, p_index_l_4, p_index_l_6, p_index_r_1) = (flat_index / (BUFFER_B_INDEX_1(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1) * BUFFER_B_INDEX_0(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1))) % BUFFER_B_INDEX_2(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1);
                              const size_t BUFFER_B_INDEX_1(p_index_l_1, p_index_l_4, p_index_l_6, p_index_r_1) = (flat_index / (BUFFER_B_INDEX_0(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1))) % BUFFER_B_INDEX_1(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1);
                              const size_t BUFFER_B_INDEX_0(p_index_l_1, p_index_l_4, p_index_l_6, p_index_r_1) = flat_index % BUFFER_B_INDEX_0(K1_P_NUM_PROCESSED_ELEMENTS_L_1, K1_P_NUM_PROCESSED_ELEMENTS_L_4, K1_P_NUM_PROCESSED_ELEMENTS_L_6, K1_P_NUM_PROCESSED_ELEMENTS_R_1);
                              #else
                              const size_t p_index_l_4 = flat_index / (K1_P_NUM_PROCESSED_ELEMENTS_L_6 * K1_P_NUM_PROCESSED_ELEMENTS_R_1 * K1_P_NUM_PROCESSED_ELEMENTS_L_1);
                              const size_t p_index_l_6 = (flat_index / (K1_P_NUM_PROCESSED_ELEMENTS_R_1 * K1_P_NUM_PROCESSED_ELEMENTS_L_1)) % K1_P_NUM_PROCESSED_ELEMENTS_L_6;
                              const size_t p_index_r_1 = (flat_index / (K1_P_NUM_PROCESSED_ELEMENTS_L_1)) % K1_P_NUM_PROCESSED_ELEMENTS_R_1;
                              const size_t p_index_l_1 = flat_index % K1_P_NUM_PROCESSED_ELEMENTS_L_1;
                              #endif
                              K1_P_MEM_B(p_index_l_1, 0, 0, p_index_l_4, 0, p_index_l_6, p_index_r_1) = K1_L_MEM_B(K1_P_TO_L_INDEX_L_1(p_index_l_1), K1_P_TO_L_INDEX_L_2(0), K1_P_TO_L_INDEX_L_3(0), K1_P_TO_L_INDEX_L_4(p_index_l_4), K1_P_TO_L_INDEX_L_5(0), K1_P_TO_L_INDEX_L_6(p_index_l_6), K1_P_TO_L_INDEX_R_1(p_index_r_1));
                            }
                            #endif
                            #endif
                            // ---------- end of P caching -------------
                            
                            for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K1_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
                              for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K1_P_NUM_CACHED_ITERATIONS_L_2; ++p_iteration_l_2) {
                                for (size_t p_iteration_l_3 = 0; p_iteration_l_3 < K1_P_NUM_CACHED_ITERATIONS_L_3; ++p_iteration_l_3) {
                                  for (size_t p_iteration_l_4 = 0; p_iteration_l_4 < K1_P_NUM_CACHED_ITERATIONS_L_4; ++p_iteration_l_4) {
                                    for (size_t p_iteration_l_5 = 0; p_iteration_l_5 < K1_P_NUM_CACHED_ITERATIONS_L_5; ++p_iteration_l_5) {
                                      for (size_t p_iteration_l_6 = 0; p_iteration_l_6 < K1_P_NUM_CACHED_ITERATIONS_L_6; ++p_iteration_l_6) {
                                        for (size_t p_iteration_r_1 = 0; p_iteration_r_1 < K1_P_NUM_CACHED_ITERATIONS_R_1; ++p_iteration_r_1) {
                                          // process one mda element
                                          K1_P_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K1_P_ITERATION_TO_P_INDEX_L_3(p_iteration_l_3), K1_P_ITERATION_TO_P_INDEX_L_4(p_iteration_l_4), K1_P_ITERATION_TO_P_INDEX_L_5(p_iteration_l_5), K1_P_ITERATION_TO_P_INDEX_L_6(p_iteration_l_6)) += f(
                                              K1_P_MEM_A(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K1_P_ITERATION_TO_P_INDEX_L_3(p_iteration_l_3), K1_P_ITERATION_TO_P_INDEX_L_4(p_iteration_l_4), K1_P_ITERATION_TO_P_INDEX_L_5(p_iteration_l_5), K1_P_ITERATION_TO_P_INDEX_L_6(p_iteration_l_6), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                              K1_P_MEM_B(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K1_P_ITERATION_TO_P_INDEX_L_3(p_iteration_l_3), K1_P_ITERATION_TO_P_INDEX_L_4(p_iteration_l_4), K1_P_ITERATION_TO_P_INDEX_L_5(p_iteration_l_5), K1_P_ITERATION_TO_P_INDEX_L_6(p_iteration_l_6), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
                                          );
                                        
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          } // end of "p_step_r_1"-loop
                          #endif
                          #endif
                          
                          // ---------- reduction --------------------
                          // will never be necessary on this level
                          // because K1_P_NUM_FU_R == 1 for OpenCL
                          // ---------- end of reduction -------------
                          
                          // move results upwards in memory hierarchy
                          #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL || K1_P_NUM_FU_R_1 > 1
                          #if K1_P_NUM_STEPS_R_1 == 0 && K1_P_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K1_P_NUM_EXTRA_ELEMENTS_R_1 > 0
                          if (K1_L_FU_ID_R_1 < (K1_P_NUM_EXTRA_ELEMENTS_R_1 + K1_P_NUM_FU_R_1 - 1) / K1_P_NUM_FU_R_1)
                          #endif
                          {
                            
                            for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K1_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
                              for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K1_P_NUM_CACHED_ITERATIONS_L_2; ++p_iteration_l_2) {
                                for (size_t p_iteration_l_3 = 0; p_iteration_l_3 < K1_P_NUM_CACHED_ITERATIONS_L_3; ++p_iteration_l_3) {
                                  for (size_t p_iteration_l_4 = 0; p_iteration_l_4 < K1_P_NUM_CACHED_ITERATIONS_L_4; ++p_iteration_l_4) {
                                    for (size_t p_iteration_l_5 = 0; p_iteration_l_5 < K1_P_NUM_CACHED_ITERATIONS_L_5; ++p_iteration_l_5) {
                                      for (size_t p_iteration_l_6 = 0; p_iteration_l_6 < K1_P_NUM_CACHED_ITERATIONS_L_6; ++p_iteration_l_6) {
                                        K1_L_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K1_P_ITERATION_TO_P_INDEX_L_3(p_iteration_l_3), K1_P_ITERATION_TO_P_INDEX_L_4(p_iteration_l_4), K1_P_ITERATION_TO_P_INDEX_L_5(p_iteration_l_5), K1_P_ITERATION_TO_P_INDEX_L_6(p_iteration_l_6)) = K1_P_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K1_P_ITERATION_TO_P_INDEX_L_3(p_iteration_l_3), K1_P_ITERATION_TO_P_INDEX_L_4(p_iteration_l_4), K1_P_ITERATION_TO_P_INDEX_L_5(p_iteration_l_5), K1_P_ITERATION_TO_P_INDEX_L_6(p_iteration_l_6));
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                          #endif
                        
                        } // end of "p_step_l_6"-loop
                        #endif
                      } // end of "p_step_l_5"-loop
                      #endif
                    } // end of "p_step_l_4"-loop
                    #endif
                  } // end of "p_step_l_3"-loop
                  #endif
                } // end of "p_step_l_2"-loop
                #endif
              } // end of "p_step_l_1"-loop
              #endif
              
              
              // wait for all WIs to finish computation on local cache block
              #if CACHE_L_CB != 0
              barrier(CLK_LOCAL_MEM_FENCE);
              #endif
              #if K1_L_NUM_STEPS_R_1 > 1
              for (l_step_r_1 = 1; l_step_r_1 < K1_L_NUM_STEPS_R_1; ++l_step_r_1) {
                // ---------- L caching --------------------
                #if CACHE_L_CB != 0
                #if (K1_L_NUM_PROCESSED_ELEMENTS_R_1 * K1_L_NUM_PROCESSED_ELEMENTS_L_5 * K1_L_NUM_PROCESSED_ELEMENTS_L_2 * K1_L_NUM_PROCESSED_ELEMENTS_L_3) / K1_L_FLAT_NUM_WI > 0
                for (size_t step = 0; step < (K1_L_NUM_PROCESSED_ELEMENTS_R_1 * K1_L_NUM_PROCESSED_ELEMENTS_L_5 * K1_L_NUM_PROCESSED_ELEMENTS_L_2 * K1_L_NUM_PROCESSED_ELEMENTS_L_3) / K1_L_FLAT_NUM_WI; ++step) {
                  const size_t flat_index = K1_L_FLAT_WI_ID + step * K1_L_FLAT_NUM_WI;
                  const size_t l_index_r_1 = flat_index / (K1_L_NUM_PROCESSED_ELEMENTS_L_5 * K1_L_NUM_PROCESSED_ELEMENTS_L_2 * K1_L_NUM_PROCESSED_ELEMENTS_L_3);
                  const size_t l_index_l_5 = (flat_index / (K1_L_NUM_PROCESSED_ELEMENTS_L_2 * K1_L_NUM_PROCESSED_ELEMENTS_L_3)) % K1_L_NUM_PROCESSED_ELEMENTS_L_5;
                  const size_t l_index_l_2 = (flat_index / (K1_L_NUM_PROCESSED_ELEMENTS_L_3)) % K1_L_NUM_PROCESSED_ELEMENTS_L_2;
                  const size_t l_index_l_3 = flat_index % K1_L_NUM_PROCESSED_ELEMENTS_L_3;
                  K1_L_MEM_A(0, l_index_l_2, l_index_l_3, 0, l_index_l_5, 0, l_index_r_1) = K1_G_MEM_A(K1_L_TO_G_INDEX_L_1(0), K1_L_TO_G_INDEX_L_2(l_index_l_2), K1_L_TO_G_INDEX_L_3(l_index_l_3), K1_L_TO_G_INDEX_L_4(0), K1_L_TO_G_INDEX_L_5(l_index_l_5), K1_L_TO_G_INDEX_L_6(0), K1_L_TO_G_INDEX_R_1(l_index_r_1));
                }
                #endif
                #if (K1_L_NUM_PROCESSED_ELEMENTS_R_1 * K1_L_NUM_PROCESSED_ELEMENTS_L_5 * K1_L_NUM_PROCESSED_ELEMENTS_L_2 * K1_L_NUM_PROCESSED_ELEMENTS_L_3) % K1_L_FLAT_NUM_WI > 0
                if (K1_L_FLAT_WI_ID < (K1_L_NUM_PROCESSED_ELEMENTS_R_1 * K1_L_NUM_PROCESSED_ELEMENTS_L_5 * K1_L_NUM_PROCESSED_ELEMENTS_L_2 * K1_L_NUM_PROCESSED_ELEMENTS_L_3) % K1_L_FLAT_NUM_WI) {
                  const size_t flat_index = K1_L_FLAT_WI_ID + ((K1_L_NUM_PROCESSED_ELEMENTS_R_1 * K1_L_NUM_PROCESSED_ELEMENTS_L_5 * K1_L_NUM_PROCESSED_ELEMENTS_L_2 * K1_L_NUM_PROCESSED_ELEMENTS_L_3) / K1_L_FLAT_NUM_WI) * K1_L_FLAT_NUM_WI;
                  const size_t l_index_r_1 = flat_index / (K1_L_NUM_PROCESSED_ELEMENTS_L_5 * K1_L_NUM_PROCESSED_ELEMENTS_L_2 * K1_L_NUM_PROCESSED_ELEMENTS_L_3);
                  const size_t l_index_l_5 = (flat_index / (K1_L_NUM_PROCESSED_ELEMENTS_L_2 * K1_L_NUM_PROCESSED_ELEMENTS_L_3)) % K1_L_NUM_PROCESSED_ELEMENTS_L_5;
                  const size_t l_index_l_2 = (flat_index / (K1_L_NUM_PROCESSED_ELEMENTS_L_3)) % K1_L_NUM_PROCESSED_ELEMENTS_L_2;
                  const size_t l_index_l_3 = flat_index % K1_L_NUM_PROCESSED_ELEMENTS_L_3;
