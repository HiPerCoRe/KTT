          #endif
        } // end of "l_step_l_4"-loop
        #endif
      } // end of "l_step_l_3"-loop
      #endif
    } // end of "l_step_l_2"-loop
    #endif
  } // end of "l_step_l_1"-loop
  #endif
}
// =============== end of kernel 1 ============================================
