#define K1_PP3_L_1_PP3_L_2_PP3_L_3_PP3_L_4_P3_IN_COMPLETE_G_CB_L_6_P_KERNEL_RES(i, j, k, l, m, n) K1_P3_L_1_P3_L_2_P3_L_3_P3_L_4_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i), K1_PP3_P_TO_L_INDEX_L_2(j), K1_PP3_P_TO_L_INDEX_L_3(k), K1_PP3_P_TO_L_INDEX_L_4(l), K1_P_TO_L_INDEX_L_5(m), K1_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_6(n))
#define K1_PP3_L_1_PP3_L_2_PP3_L_3_PP3_L_4_PP3_L_6_P_KERNEL_RES(i, j, k, l, m, n) K1_P3_L_1_P3_L_2_P3_L_3_P3_L_4_P3_L_6_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i), K1_PP3_P_TO_L_INDEX_L_2(j), K1_PP3_P_TO_L_INDEX_L_3(k), K1_PP3_P_TO_L_INDEX_L_4(l), K1_P_TO_L_INDEX_L_5(m), K1_PP3_P_TO_L_INDEX_L_6(n))
#define K1_PP3_L_1_PP3_L_2_PP3_L_3_PP3_L_4_P3_L_5_P_KERNEL_RES(i, j, k, l, m, n) K1_P3_L_1_P3_L_2_P3_L_3_P3_L_4_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i), K1_PP3_P_TO_L_INDEX_L_2(j), K1_PP3_P_TO_L_INDEX_L_3(k), K1_PP3_P_TO_L_INDEX_L_4(l), K1_P3_P_TO_L_INDEX_L_5(m), K1_P_TO_L_INDEX_L_6(n))
#define K1_PP3_L_1_PP3_L_2_PP3_L_3_PP3_L_4_P3_L_5_P3_L_6_P_KERNEL_RES(i, j, k, l, m, n) K1_P3_L_1_P3_L_2_P3_L_3_P3_L_4_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i), K1_PP3_P_TO_L_INDEX_L_2(j), K1_PP3_P_TO_L_INDEX_L_3(k), K1_PP3_P_TO_L_INDEX_L_4(l), K1_P3_P_TO_L_INDEX_L_5(m), K1_P3_P_TO_L_INDEX_L_6(n))
#define K1_PP3_L_1_PP3_L_2_PP3_L_3_PP3_L_4_P3_L_5_P3_IN_COMPLETE_G_CB_L_6_P_KERNEL_RES(i, j, k, l, m, n) K1_P3_L_1_P3_L_2_P3_L_3_P3_L_4_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i), K1_PP3_P_TO_L_INDEX_L_2(j), K1_PP3_P_TO_L_INDEX_L_3(k), K1_PP3_P_TO_L_INDEX_L_4(l), K1_P3_P_TO_L_INDEX_L_5(m), K1_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_6(n))
#define K1_PP3_L_1_PP3_L_2_PP3_L_3_PP3_L_4_P3_L_5_PP3_L_6_P_KERNEL_RES(i, j, k, l, m, n) K1_P3_L_1_P3_L_2_P3_L_3_P3_L_4_P3_L_6_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i), K1_PP3_P_TO_L_INDEX_L_2(j), K1_PP3_P_TO_L_INDEX_L_3(k), K1_PP3_P_TO_L_INDEX_L_4(l), K1_P3_P_TO_L_INDEX_L_5(m), K1_PP3_P_TO_L_INDEX_L_6(n))
#define K1_PP3_L_1_PP3_L_2_PP3_L_3_PP3_L_4_P3_IN_COMPLETE_G_CB_L_5_P_KERNEL_RES(i, j, k, l, m, n) K1_P3_L_1_P3_L_2_P3_L_3_P3_L_4_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i), K1_PP3_P_TO_L_INDEX_L_2(j), K1_PP3_P_TO_L_INDEX_L_3(k), K1_PP3_P_TO_L_INDEX_L_4(l), K1_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_5(m), K1_P_TO_L_INDEX_L_6(n))
#define K1_PP3_L_1_PP3_L_2_PP3_L_3_PP3_L_4_P3_IN_COMPLETE_G_CB_L_5_P3_L_6_P_KERNEL_RES(i, j, k, l, m, n) K1_P3_L_1_P3_L_2_P3_L_3_P3_L_4_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i), K1_PP3_P_TO_L_INDEX_L_2(j), K1_PP3_P_TO_L_INDEX_L_3(k), K1_PP3_P_TO_L_INDEX_L_4(l), K1_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_5(m), K1_P3_P_TO_L_INDEX_L_6(n))
#define K1_PP3_L_1_PP3_L_2_PP3_L_3_PP3_L_4_P3_IN_COMPLETE_G_CB_L_5_P3_IN_COMPLETE_G_CB_L_6_P_KERNEL_RES(i, j, k, l, m, n) K1_P3_L_1_P3_L_2_P3_L_3_P3_L_4_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i), K1_PP3_P_TO_L_INDEX_L_2(j), K1_PP3_P_TO_L_INDEX_L_3(k), K1_PP3_P_TO_L_INDEX_L_4(l), K1_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_5(m), K1_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_6(n))
#define K1_PP3_L_1_PP3_L_2_PP3_L_3_PP3_L_4_P3_IN_COMPLETE_G_CB_L_5_PP3_L_6_P_KERNEL_RES(i, j, k, l, m, n) K1_P3_L_1_P3_L_2_P3_L_3_P3_L_4_P3_L_6_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i), K1_PP3_P_TO_L_INDEX_L_2(j), K1_PP3_P_TO_L_INDEX_L_3(k), K1_PP3_P_TO_L_INDEX_L_4(l), K1_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_5(m), K1_PP3_P_TO_L_INDEX_L_6(n))
#define K1_PP3_L_1_PP3_L_2_PP3_L_3_PP3_L_4_PP3_L_5_P_KERNEL_RES(i, j, k, l, m, n) K1_P3_L_1_P3_L_2_P3_L_3_P3_L_4_P3_L_5_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i), K1_PP3_P_TO_L_INDEX_L_2(j), K1_PP3_P_TO_L_INDEX_L_3(k), K1_PP3_P_TO_L_INDEX_L_4(l), K1_PP3_P_TO_L_INDEX_L_5(m), K1_P_TO_L_INDEX_L_6(n))
#define K1_PP3_L_1_PP3_L_2_PP3_L_3_PP3_L_4_PP3_L_5_P3_L_6_P_KERNEL_RES(i, j, k, l, m, n) K1_P3_L_1_P3_L_2_P3_L_3_P3_L_4_P3_L_5_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i), K1_PP3_P_TO_L_INDEX_L_2(j), K1_PP3_P_TO_L_INDEX_L_3(k), K1_PP3_P_TO_L_INDEX_L_4(l), K1_PP3_P_TO_L_INDEX_L_5(m), K1_P3_P_TO_L_INDEX_L_6(n))
#define K1_PP3_L_1_PP3_L_2_PP3_L_3_PP3_L_4_PP3_L_5_P3_IN_COMPLETE_G_CB_L_6_P_KERNEL_RES(i, j, k, l, m, n) K1_P3_L_1_P3_L_2_P3_L_3_P3_L_4_P3_L_5_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i), K1_PP3_P_TO_L_INDEX_L_2(j), K1_PP3_P_TO_L_INDEX_L_3(k), K1_PP3_P_TO_L_INDEX_L_4(l), K1_PP3_P_TO_L_INDEX_L_5(m), K1_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_6(n))
#define K1_PP3_L_1_PP3_L_2_PP3_L_3_PP3_L_4_PP3_L_5_PP3_L_6_P_KERNEL_RES(i, j, k, l, m, n) K1_P3_L_1_P3_L_2_P3_L_3_P3_L_4_P3_L_5_P3_L_6_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i), K1_PP3_P_TO_L_INDEX_L_2(j), K1_PP3_P_TO_L_INDEX_L_3(k), K1_PP3_P_TO_L_INDEX_L_4(l), K1_PP3_P_TO_L_INDEX_L_5(m), K1_PP3_P_TO_L_INDEX_L_6(n))
// =============== end of macro definitions per buffer ========================

// =============== scalar function ============================================
inline TYPE_TS f(const TYPE_T a_val, const TYPE_T b_val) {
  return a_val * b_val;
}
// =============== end of scalar function =====================================

// =============== kernel 1 ===================================================
__kernel void tc_1(__global TYPE_T const * const restrict a, __global TYPE_T const * const restrict b, __global TYPE_TS * const restrict res_g, __global TYPE_TS * const restrict int_res) {
  // map md_hom dimensions to OpenCL dimensions
  const size_t i_wg_l_1 = GET_GROUP_ID_L_1;
  const size_t i_wi_l_1 = GET_LOCAL_ID_L_1;
  
  const size_t i_wg_l_2 = GET_GROUP_ID_L_2;
  const size_t i_wi_l_2 = GET_LOCAL_ID_L_2;
  
  const size_t i_wg_l_3 = GET_GROUP_ID_L_3;
  const size_t i_wi_l_3 = GET_LOCAL_ID_L_3;
  
  const size_t i_wg_l_4 = GET_GROUP_ID_L_4;
  const size_t i_wi_l_4 = GET_LOCAL_ID_L_4;
  
  const size_t i_wg_l_5 = GET_GROUP_ID_L_5;
  const size_t i_wi_l_5 = GET_LOCAL_ID_L_5;
  
  const size_t i_wg_l_6 = GET_GROUP_ID_L_6;
  const size_t i_wi_l_6 = GET_LOCAL_ID_L_6;
  
  const size_t i_wg_r_1 = GET_GROUP_ID_R_1;
  const size_t i_wi_r_1 = GET_LOCAL_ID_R_1;
  
  // declare variables for caching inputs
  #if CACHE_L_CB != 0
  __local TYPE_T cb_l_a[BUFFER_A_L_SIZE_3][BUFFER_A_L_SIZE_2][BUFFER_A_L_SIZE_1][BUFFER_A_L_SIZE_0];
  __local TYPE_T cb_l_b[BUFFER_B_L_SIZE_3][BUFFER_B_L_SIZE_2][BUFFER_B_L_SIZE_1][BUFFER_B_L_SIZE_0];
  #endif
  #if CACHE_P_CB != 0
  __private TYPE_T cb_p_a[BUFFER_A_P_SIZE_3][BUFFER_A_P_SIZE_2][BUFFER_A_P_SIZE_1][BUFFER_A_P_SIZE_0];
  __private TYPE_T cb_p_b[BUFFER_B_P_SIZE_3][BUFFER_B_P_SIZE_2][BUFFER_B_P_SIZE_1][BUFFER_B_P_SIZE_0];
  #endif

  // declare variables for result memory
  // ------ LOCAL ------
  #ifdef K1_L_LEVEL_HAS_RESULTS
  __local TYPE_TS K1_RES_L_BUFFER_DEF;
  #endif
  // ------ PRIVATE ------
  #ifdef K1_P_LEVEL_HAS_RESULTS
  __private TYPE_TS K1_RES_P_BUFFER_DEF;
  #endif
  
  // declare variables for reduction memory (if needed)
  #if L_CB_RES_DEST_LEVEL < LOCAL && (K1_L_NUM_FU_R_1 > 1)
  __local TYPE_TS K1_L_REDUCTION_MEM_NAME()CONCAT_IN_DESCENDING_OCL_ORDER([K1_L_CB_SIZE_L_1], [K1_L_CB_SIZE_L_2], [K1_L_CB_SIZE_L_3], [K1_L_CB_SIZE_L_4], [K1_L_CB_SIZE_L_5], [K1_L_CB_SIZE_L_6], [K1_L_NUM_FU_R_1]);
  #endif

  // reset memory where reduction takes place for WIs that do not
  // calculate intermediate results, so that reduction can always
  // be done with all WIs
  #if K1_L_NUM_FU_R_1 > 1
  #if ((K1_L_NUM_STEPS_R_1 > 0 && K1_P_NUM_STEPS_R_1 == 0 && K1_P_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0) ||\
      (K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 > 0 && K1_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1 == 0 && K1_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1 == 0) ||\
      (K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K1_L_NUM_EXTRA_ELEMENTS_R_1 > 0))
  #if K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K1_L_NUM_EXTRA_ELEMENTS_R_1 > 0
  if (K1_G_FU_ID_R_1 < (K1_L_NUM_EXTRA_ELEMENTS_R_1 + K1_L_NUM_FU_R_1 - 1) / K1_L_NUM_FU_R_1)
  #endif
  {
    #if K1_L_NUM_STEPS_R_1 > 0 && K1_P_NUM_STEPS_R_1 == 0 && K1_P_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0
    const int num_active_wi_r_1 = K1_P_NUM_EXTRA_ELEMENTS_R_1;
    #elif K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 > 0 && K1_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1 == 0 && K1_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1 == 0
    const int num_active_wi_r_1 = K1_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_R_1;
    #elif K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K1_L_NUM_EXTRA_ELEMENTS_R_1 > 0
    const int num_active_wi_r_1 = K1_L_NUM_EXTRA_ELEMENTS_R_1 - K1_G_FU_ID_R_1 * K1_L_NUM_FU_R_1;
    #endif
    
    if (K1_L_FU_ID_R_1 >= num_active_wi_r_1) {
      #if L_CB_RES_DEST_LEVEL != GLOBAL
      // phase 1: process private cached iterations in dimension L_1 with all FUs
      #if K1_P_NUM_STEPS_L_1 > 0
      for (size_t p_step_l_1 = 0; p_step_l_1 < K1_P_NUM_STEPS_L_1; ++p_step_l_1) {
        // phase 1: process private cached iterations in dimension L_2 with all FUs
        #if K1_P_NUM_STEPS_L_2 > 0
        for (size_t p_step_l_2 = 0; p_step_l_2 < K1_P_NUM_STEPS_L_2; ++p_step_l_2) {
          // phase 1: process private cached iterations in dimension L_3 with all FUs
          #if K1_P_NUM_STEPS_L_3 > 0
          for (size_t p_step_l_3 = 0; p_step_l_3 < K1_P_NUM_STEPS_L_3; ++p_step_l_3) {
            // phase 1: process private cached iterations in dimension L_4 with all FUs
            #if K1_P_NUM_STEPS_L_4 > 0
            for (size_t p_step_l_4 = 0; p_step_l_4 < K1_P_NUM_STEPS_L_4; ++p_step_l_4) {
              // phase 1: process private cached iterations in dimension L_5 with all FUs
              #if K1_P_NUM_STEPS_L_5 > 0
              for (size_t p_step_l_5 = 0; p_step_l_5 < K1_P_NUM_STEPS_L_5; ++p_step_l_5) {
                // phase 1: process private cached iterations in dimension L_6 with all FUs
                #if K1_P_NUM_STEPS_L_6 > 0
                for (size_t p_step_l_6 = 0; p_step_l_6 < K1_P_NUM_STEPS_L_6; ++p_step_l_6) {
                  for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K1_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
                    for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K1_P_NUM_CACHED_ITERATIONS_L_2; ++p_iteration_l_2) {
                      for (size_t p_iteration_l_3 = 0; p_iteration_l_3 < K1_P_NUM_CACHED_ITERATIONS_L_3; ++p_iteration_l_3) {
                        for (size_t p_iteration_l_4 = 0; p_iteration_l_4 < K1_P_NUM_CACHED_ITERATIONS_L_4; ++p_iteration_l_4) {
                          for (size_t p_iteration_l_5 = 0; p_iteration_l_5 < K1_P_NUM_CACHED_ITERATIONS_L_5; ++p_iteration_l_5) {
                            for (size_t p_iteration_l_6 = 0; p_iteration_l_6 < K1_P_NUM_CACHED_ITERATIONS_L_6; ++p_iteration_l_6) {
                              K1_L_CB_RES_DEST(p_iteration_l_1, p_iteration_l_2, p_iteration_l_3, p_iteration_l_4, p_iteration_l_5, p_iteration_l_6) = 0;
                            }
                          }
                        }
                      }
                    }
                  }
                } // end of "p_step_l_6"-loop
                #endif
              } // end of "p_step_l_5"-loop
              #endif
            } // end of "p_step_l_4"-loop
            #endif
          } // end of "p_step_l_3"-loop
          #endif
        } // end of "p_step_l_2"-loop
        #endif
      } // end of "p_step_l_1"-loop
      #endif
      #else
      // phase 1: process local cached iterations in dimension L_1 with all FUs
      #if K1_L_NUM_STEPS_L_1 > 0
      for (size_t l_step_l_1 = 0; l_step_l_1 < K1_L_NUM_STEPS_L_1; ++l_step_l_1) {
        // phase 1: process local cached iterations in dimension L_2 with all FUs
        #if K1_L_NUM_STEPS_L_2 > 0
        for (size_t l_step_l_2 = 0; l_step_l_2 < K1_L_NUM_STEPS_L_2; ++l_step_l_2) {
          // phase 1: process local cached iterations in dimension L_3 with all FUs
          #if K1_L_NUM_STEPS_L_3 > 0
          for (size_t l_step_l_3 = 0; l_step_l_3 < K1_L_NUM_STEPS_L_3; ++l_step_l_3) {
            // phase 1: process local cached iterations in dimension L_4 with all FUs
            #if K1_L_NUM_STEPS_L_4 > 0
            for (size_t l_step_l_4 = 0; l_step_l_4 < K1_L_NUM_STEPS_L_4; ++l_step_l_4) {
              // phase 1: process local cached iterations in dimension L_5 with all FUs
              #if K1_L_NUM_STEPS_L_5 > 0
              for (size_t l_step_l_5 = 0; l_step_l_5 < K1_L_NUM_STEPS_L_5; ++l_step_l_5) {
                // phase 1: process local cached iterations in dimension L_6 with all FUs
                #if K1_L_NUM_STEPS_L_6 > 0
                for (size_t l_step_l_6 = 0; l_step_l_6 < K1_L_NUM_STEPS_L_6; ++l_step_l_6) {
                  
                  // phase 1: process private cached iterations in dimension L_1 with all FUs
                  #if K1_P_NUM_STEPS_L_1 > 0
                  for (size_t p_step_l_1 = 0; p_step_l_1 < K1_P_NUM_STEPS_L_1; ++p_step_l_1) {
                    // phase 1: process private cached iterations in dimension L_2 with all FUs
                    #if K1_P_NUM_STEPS_L_2 > 0
                    for (size_t p_step_l_2 = 0; p_step_l_2 < K1_P_NUM_STEPS_L_2; ++p_step_l_2) {
                      // phase 1: process private cached iterations in dimension L_3 with all FUs
                      #if K1_P_NUM_STEPS_L_3 > 0
                      for (size_t p_step_l_3 = 0; p_step_l_3 < K1_P_NUM_STEPS_L_3; ++p_step_l_3) {
                        // phase 1: process private cached iterations in dimension L_4 with all FUs
                        #if K1_P_NUM_STEPS_L_4 > 0
                        for (size_t p_step_l_4 = 0; p_step_l_4 < K1_P_NUM_STEPS_L_4; ++p_step_l_4) {
                          // phase 1: process private cached iterations in dimension L_5 with all FUs
                          #if K1_P_NUM_STEPS_L_5 > 0
                          for (size_t p_step_l_5 = 0; p_step_l_5 < K1_P_NUM_STEPS_L_5; ++p_step_l_5) {
                            // phase 1: process private cached iterations in dimension L_6 with all FUs
                            #if K1_P_NUM_STEPS_L_6 > 0
                            for (size_t p_step_l_6 = 0; p_step_l_6 < K1_P_NUM_STEPS_L_6; ++p_step_l_6) {
                              for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K1_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
                                for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K1_P_NUM_CACHED_ITERATIONS_L_2; ++p_iteration_l_2) {
                                  for (size_t p_iteration_l_3 = 0; p_iteration_l_3 < K1_P_NUM_CACHED_ITERATIONS_L_3; ++p_iteration_l_3) {
                                    for (size_t p_iteration_l_4 = 0; p_iteration_l_4 < K1_P_NUM_CACHED_ITERATIONS_L_4; ++p_iteration_l_4) {
                                      for (size_t p_iteration_l_5 = 0; p_iteration_l_5 < K1_P_NUM_CACHED_ITERATIONS_L_5; ++p_iteration_l_5) {
                                        for (size_t p_iteration_l_6 = 0; p_iteration_l_6 < K1_P_NUM_CACHED_ITERATIONS_L_6; ++p_iteration_l_6) {
