#define K1_RES_G_BUFFER(i, j, k, l, m, n, o, p, q) K1_RES_G_BUFFER_NAME()[FLAT_INDEX_IN_DESCENDING_OCL_ORDER(i, j, k, l, m, n, K1_RES_G_BUFFER_SUFFIX_R_1(o, p, q), K1_G_CB_SIZE_L_1, K1_G_CB_SIZE_L_2, K1_G_CB_SIZE_L_3, K1_G_CB_SIZE_L_4, K1_G_CB_SIZE_L_5, K1_G_CB_SIZE_L_6, K1_RES_G_BUFFER_DEF_SUFFIX_R_1)]
