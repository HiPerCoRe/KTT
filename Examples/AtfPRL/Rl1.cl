#endif

// number of extra elements in incomplete cache blocks
#if K1_P_NUM_CACHED_ITERATIONS_R_1 > 0
#define K1_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_R_1 ((GET_LOCAL_SIZE_R_1 * K1_L_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1) % (GET_LOCAL_SIZE_R_1 * K1_P_NUM_CACHED_ITERATIONS_R_1) % GET_LOCAL_SIZE_R_1)
#else
#define K1_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_R_1 0
#endif

// number of processed elements in incomplete cache blocks
#define K1_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1 K1_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_R_1
#define K1_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1 K1_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1
#define K1_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1 ((K1_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1 * K1_P_NUM_CACHED_ITERATIONS_R_1 + K1_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1) * GET_LOCAL_SIZE_R_1 + K1_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_R_1)

// index conversion
#define K1_L_TO_G_INDEX_R_1(i) (l_cb_offset_r_1 + ((i) / K1_L_NUM_FU_R_1) * GET_GLOBAL_SIZE_R_1 + ((i) % K1_L_NUM_FU_R_1))
#define K1_P_TO_L_INDEX_R_1(i) (p_cb_offset_r_1 + ((i) / K1_P_NUM_FU_R_1) * GET_LOCAL_SIZE_R_1 + ((i) % K1_P_NUM_FU_R_1))

// index conversion in phase 3
#define K1_P3_L_TO_G_INDEX_R_1(i) (l_cb_offset_r_1 + (i))
#define K1_P3_P_TO_L_INDEX_R_1(i) (p_cb_offset_r_1 + (i))
#define K1_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_R_1(i) (p_cb_offset_r_1 + (i))
#define K1_PP3_P_TO_L_INDEX_R_1(i) (p_cb_offset_r_1 + (i))

// index conversion per FU
#define K1_FU_L_TO_G_INDEX_R_1(i) (l_cb_offset_r_1 + ((i) / K1_L_NUM_FU_R_1) * GET_GLOBAL_SIZE_R_1 + K1_L_FU_ID_R_1)
#define K1_FU_P_TO_L_INDEX_R_1(i) (p_cb_offset_r_1 + ((i) / K1_P_NUM_FU_R_1) * GET_LOCAL_SIZE_R_1 + K1_P_FU_ID_R_1)

// index conversion per FU in phase 3
#define K1_FU_P3_L_TO_G_INDEX_R_1(i) (l_cb_offset_r_1 + (i))
#define K1_FU_P3_P_TO_L_INDEX_R_1(i) (p_cb_offset_r_1 + (i))
