// -------------------- combined over dimensions --------------------

// flat WI ids
#define K1_G_FLAT_WI_ID (FLAT_INDEX_IN_DESCENDING_OCL_ORDER(GET_GLOBAL_ID_L_1, GET_GLOBAL_ID_R_1, GET_GLOBAL_SIZE_L_1, GET_GLOBAL_SIZE_R_1))
#define K1_L_FLAT_WI_ID (FLAT_INDEX_IN_DESCENDING_OCL_ORDER(GET_LOCAL_ID_L_1, GET_LOCAL_ID_R_1, GET_LOCAL_SIZE_L_1, GET_LOCAL_SIZE_R_1))
#define K1_P_FLAT_WI_ID (0)

