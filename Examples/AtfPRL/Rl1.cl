  // declare variables for result memory
  // ------ LOCAL ------
  #ifdef K1_L_LEVEL_HAS_RESULTS
  __local long MATCH_ID_STR(K1_RES_L_BUFFER_DEF);
  __local double MATCH_WEIGHT_STR(K1_RES_L_BUFFER_DEF);
  __local int ID_MEASURE_STR(K1_RES_L_BUFFER_DEF);
  #endif
  // ------ PRIVATE ------
  #ifdef K1_P_LEVEL_HAS_RESULTS
  __private long MATCH_ID_STR(K1_RES_P_BUFFER_DEF);
  __private double MATCH_WEIGHT_STR(K1_RES_P_BUFFER_DEF);
  __private int ID_MEASURE_STR(K1_RES_P_BUFFER_DEF);
  #endif

  // declare variables for reduction memory (if needed)
  #if L_CB_RES_DEST_LEVEL < LOCAL && (K1_L_NUM_FU_R_1 > 1)
  __local long MATCH_ID_STR(K1_L_REDUCTION_MEM_NAME()CONCAT_IN_DESCENDING_OCL_ORDER([K1_L_CB_SIZE_L_1], [K1_L_NUM_FU_R_1]));
  __local double MATCH_WEIGHT_STR(K1_L_REDUCTION_MEM_NAME()CONCAT_IN_DESCENDING_OCL_ORDER([K1_L_CB_SIZE_L_1], [K1_L_NUM_FU_R_1]));
  __local int ID_MEASURE_STR(K1_L_REDUCTION_MEM_NAME()CONCAT_IN_DESCENDING_OCL_ORDER([K1_L_CB_SIZE_L_1], [K1_L_NUM_FU_R_1]));
  #endif

  // reset memory where reduction takes place for WIs that do not
  // calculate intermediate results, so that reduction can always
  // be done with all WIs
  #if K1_L_NUM_FU_R_1 > 1
  #if ((K1_L_NUM_STEPS_R_1 > 0 && K1_P_NUM_STEPS_R_1 == 0 && K1_P_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0) || (K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 > 0 && K1_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1 == 0 && K1_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1 == 0) || (K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K1_L_NUM_EXTRA_ELEMENTS_R_1 > 0))
  #if (K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K1_L_NUM_EXTRA_ELEMENTS_R_1 > 0)
  if (true
  #endif
  #if K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K1_L_NUM_EXTRA_ELEMENTS_R_1 > 0
      && (K1_G_FU_ID_R_1 < (K1_L_NUM_EXTRA_ELEMENTS_R_1 + K1_L_NUM_FU_R_1 - 1) / K1_L_NUM_FU_R_1)
  #endif
  #if (K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K1_L_NUM_EXTRA_ELEMENTS_R_1 > 0)
  )
  #endif
  {
    #if K1_L_NUM_STEPS_R_1 > 0 && K1_P_NUM_STEPS_R_1 == 0 && K1_P_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0
    #define NUM_ACTIVE_WI_R_1
    const int num_active_wi_r_1 = K1_P_NUM_EXTRA_ELEMENTS_R_1;
    #elif K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 > 0 && K1_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1 == 0 && K1_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1 == 0
    #define NUM_ACTIVE_WI_R_1
    const int num_active_wi_r_1 = K1_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_R_1;
    #elif K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K1_L_NUM_EXTRA_ELEMENTS_R_1 > 0
    #define NUM_ACTIVE_WI_R_1
    const int num_active_wi_r_1 = K1_L_NUM_EXTRA_ELEMENTS_R_1 - K1_G_FU_ID_R_1 * K1_L_NUM_FU_R_1;
    #endif
    
    if (true
    #ifdef NUM_ACTIVE_WI_R_1
     || K1_L_FU_ID_R_1 >= num_active_wi_r_1
    #endif
    ) {
      #if L_CB_RES_DEST_LEVEL != GLOBAL
      p_cb_offset_l_1 = K1_L_FU_ID_L_1 * K1_P_NUM_FU_L_1;
      
      // phase 1: process private cached iterations in dimension L_1 with all FUs
      #if K1_P_NUM_STEPS_L_1 > 0
      for (size_t p_step_l_1 = 0; p_step_l_1 < K1_P_NUM_STEPS_L_1; ++p_step_l_1) {
        for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K1_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
          MATCH_ID_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0;
          MATCH_WEIGHT_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0.0;
          ID_MEASURE_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0;
        }
        
        p_cb_offset_l_1 += GET_LOCAL_SIZE_L_1 * K1_P_NUM_CACHED_ITERATIONS_L_1;
      } // end of "p_step_l_1"-loop
      #endif
      // phase 2: process extra private iterations in dimension L_1 with all FUs
      #if K1_P_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0
      {  
        const size_t p_step_l_1 = K1_P_NUM_STEPS_L_1;
        for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K1_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_L_1; ++p_iteration_l_1) {
          MATCH_ID_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0;
          MATCH_WEIGHT_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0.0;
          ID_MEASURE_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0;
        }
        
        p_cb_offset_l_1 += GET_LOCAL_SIZE_L_1 * K1_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_L_1;
      }
      #endif
      // phase 3: process extra private elements in dimension L_1 with a subset of all FUs
      #if K1_P_NUM_EXTRA_ELEMENTS_L_1 > 0
      if (K1_L_FU_ID_L_1 < (K1_P_NUM_EXTRA_ELEMENTS_L_1 + K1_P_NUM_FU_L_1 - 1) / K1_P_NUM_FU_L_1) {  
        // set step variable for access to res buffer
        const size_t p_step_l_1 = K1_P_NUM_STEPS_L_1 + (K1_P_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0);
        {
          size_t p_iteration_l_1 = 0;
          MATCH_ID_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0;
          MATCH_WEIGHT_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0.0;
          ID_MEASURE_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0;
        }
        
      
      }
      #endif
      #else
      l_cb_offset_l_1 = K1_G_FU_ID_L_1 * K1_L_NUM_FU_L_1;
      
      // phase 1: process local cached iterations in dimension L_1 with all FUs
      #if K1_L_NUM_STEPS_L_1 > 0
      for (size_t l_step_l_1 = 0; l_step_l_1 < K1_L_NUM_STEPS_L_1; ++l_step_l_1) {
        
        p_cb_offset_l_1 = K1_L_FU_ID_L_1 * K1_P_NUM_FU_L_1;
        
        // phase 1: process private cached iterations in dimension L_1 with all FUs
        #if K1_P_NUM_STEPS_L_1 > 0
        for (size_t p_step_l_1 = 0; p_step_l_1 < K1_P_NUM_STEPS_L_1; ++p_step_l_1) {
          for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K1_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
            MATCH_ID_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0;
            MATCH_WEIGHT_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0.0;
            ID_MEASURE_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0;
          }
          
          p_cb_offset_l_1 += GET_LOCAL_SIZE_L_1 * K1_P_NUM_CACHED_ITERATIONS_L_1;
        } // end of "p_step_l_1"-loop
        #endif
        // phase 2: process extra private iterations in dimension L_1 with all FUs
        #if K1_P_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0
        {  
          const size_t p_step_l_1 = K1_P_NUM_STEPS_L_1;
          for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K1_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_L_1; ++p_iteration_l_1) {
            MATCH_ID_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0;
            MATCH_WEIGHT_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0.0;
            ID_MEASURE_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0;
          }
          
          p_cb_offset_l_1 += GET_LOCAL_SIZE_L_1 * K1_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_L_1;
        }
        #endif
        // phase 3: process extra private elements in dimension L_1 with a subset of all FUs
        #if K1_P_NUM_EXTRA_ELEMENTS_L_1 > 0
        if (K1_L_FU_ID_L_1 < (K1_P_NUM_EXTRA_ELEMENTS_L_1 + K1_P_NUM_FU_L_1 - 1) / K1_P_NUM_FU_L_1) {  
          // set step variable for access to res buffer
          const size_t p_step_l_1 = K1_P_NUM_STEPS_L_1 + (K1_P_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0);
          {
            size_t p_iteration_l_1 = 0;
            MATCH_ID_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0;
            MATCH_WEIGHT_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0.0;
            ID_MEASURE_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0;
          }
          
        
        }
        #endif
        
        
        l_cb_offset_l_1 += GET_GLOBAL_SIZE_L_1 * K1_L_NUM_CACHED_ITERATIONS_L_1;
      } // end of "l_step_l_1"-loop
      #endif
      // phase 2: process extra local iterations in dimension L_1 with all FUs
      #if K1_L_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0
      {  
        const size_t l_step_l_1 = K1_L_NUM_STEPS_L_1;
        p_cb_offset_l_1 = K1_L_FU_ID_L_1 * K1_P_NUM_FU_L_1;
        
        // phase 1: process private cached iterations in dimension L_1 with all FUs
        #if K1_P_NUM_STEPS_IN_COMPLETE_G_CB_L_1 > 0
        for (size_t p_step_l_1 = 0; p_step_l_1 < K1_P_NUM_STEPS_IN_COMPLETE_G_CB_L_1; ++p_step_l_1) {
          for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K1_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
            MATCH_ID_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0;
            MATCH_WEIGHT_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0.0;
            ID_MEASURE_STR(K1_FU_L_CB_RES_DEST(p_iteration_l_1)) = 0;
          }
          
          p_cb_offset_l_1 += GET_LOCAL_SIZE_L_1 * K1_P_NUM_CACHED_ITERATIONS_L_1;
        } // end of "p_step_l_1"-loop
        #endif
        // phase 2: process extra private iterations in dimension L_1 with all FUs
        #if K1_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_1 > 0
        {  
          const size_t p_step_l_1 = K1_P_NUM_STEPS_IN_COMPLETE_G_CB_L_1;
