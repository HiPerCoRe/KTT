// =============== macro definitions per buffer ===============================
// -------------------- buffer N_ID --------------------

// buffer abstraction
#define BUFFER_N_ID_INDEX_0(i) i
#define BUFFER_N_ID_G_SIZE_0 K1_G_CB_SIZE_L_1
#define BUFFER_N_ID_L_SIZE_0 K1_L_CB_SIZE_L_1
#define BUFFER_N_ID_P_SIZE_0 K1_P_CB_SIZE_L_1
#define K1_G_BUFFER_N_ID(i) n_id[(i)]
#define K1_L_BUFFER_N_ID(i) cb_l_n_id[(BUFFER_N_ID_INDEX_0(i))]
#define K1_P_BUFFER_N_ID(i) cb_p_n_id[(BUFFER_N_ID_INDEX_0(i))]

// partitioning and cache usage
#define K1_G_MEM_N_ID(i, j) K1_G_BUFFER_N_ID(i)
#if CACHE_L_CB != 0
#define K1_L_MEM_N_ID(i, j) K1_L_BUFFER_N_ID(i)
#define K1_P3_L_1_L_MEM_N_ID(i, j) K1_L_BUFFER_N_ID(i)
#else
#define K1_L_MEM_N_ID(i, j) K1_G_MEM_N_ID(K1_L_TO_G_INDEX_L_1(i), K1_L_TO_G_INDEX_R_1(j))
#define K1_P3_L_1_L_MEM_N_ID(i, j) K1_G_MEM_N_ID(K1_P3_L_TO_G_INDEX_L_1(i), K1_L_TO_G_INDEX_R_1(j))
#endif
#if CACHE_P_CB != 0
#define K1_P_MEM_N_ID(i, j) K1_P_BUFFER_N_ID(i)
#define K1_P3_L_1_P_MEM_N_ID(i, j) K1_P_BUFFER_N_ID(i)
#define K1_P3_IN_COMPLETE_G_CB_L_1_P_MEM_N_ID(i, j) K1_P_BUFFER_N_ID(i)
#define K1_PP3_L_1_P_MEM_N_ID(i, j) K1_P_BUFFER_N_ID(i)
#else
#define K1_P_MEM_N_ID(i, j) K1_L_MEM_N_ID(K1_P_TO_L_INDEX_L_1(i), K1_P_TO_L_INDEX_R_1(j))
