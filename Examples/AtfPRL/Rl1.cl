                  K1_FU_P3_L_1_P_MEM_N_BIRTHMONTH(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_BIRTHYEAR(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_CIN(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_PROB_LASTNAME1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_PROB_LASTNAME2(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_PROB_LASTNAME3(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_PROB_FIRSTNAME1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_PROB_FIRSTNAME2(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_PROB_FIRSTNAME3(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_PROB_BIRTHNAME1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_PROB_BIRTHNAME2(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_PROB_BIRTHNAME3(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_PROB_BIRTHDAY(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_PROB_GENDER(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_PROB_BIRTHMONTH(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_PROB_BIRTHYEAR(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_P3_L_1_P_MEM_N_PROB_CIN(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_ID(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_LASTNAME1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_LASTNAME2(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_LASTNAME3(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_FIRSTNAME1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_FIRSTNAME2(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_FIRSTNAME3(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_FIRSTNAME_GROUP1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_FIRSTNAME_GROUP2(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_FIRSTNAME_GROUP3(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_BIRTHNAME1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_BIRTHNAME2(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_BIRTHNAME3(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_BIRTHDAY(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_GENDER(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_BIRTHMONTH(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_BIRTHYEAR(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_CIN(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_PROB_LASTNAME1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_PROB_LASTNAME2(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_PROB_LASTNAME3(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_PROB_FIRSTNAME1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_PROB_FIRSTNAME2(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_PROB_FIRSTNAME3(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_PROB_BIRTHNAME1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_PROB_BIRTHNAME2(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_PROB_BIRTHNAME3(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_PROB_BIRTHDAY(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_PROB_GENDER(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_PROB_BIRTHMONTH(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_PROB_BIRTHYEAR(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  K1_FU_PP3_R_1_P_MEM_I_PROB_CIN(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K1_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                  &MATCH_ID_STR(K1_FU_P3_L_1_P_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                  &MATCH_WEIGHT_STR(K1_FU_P3_L_1_P_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                  &ID_MEASURE_STR(K1_FU_P3_L_1_P_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)))
                );
              }
            
            }
          }
          #endif
          
        
        }
        
        
        // ---------- reduction --------------------
        // will never be necessary on this level
        // because K1_P_NUM_FU_R == 1 for OpenCL
        // ---------- end of reduction -------------
        
        // move results upwards in memory hierarchy
        #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL || K1_P_NUM_FU_R_1 > 1
        #if 1
        if (true
        #endif
            && (K1_L_FU_ID_R_1 < K1_L_NUM_EXTRA_ELEMENTS_R_1 - K1_G_FU_ID_R_1 * K1_L_NUM_FU_R_1)
        #if 1
        )
        #endif
        {
          
          {
            size_t p_iteration_l_1 = 0;
            p_combine_in_l_cb(&MATCH_ID_STR(K1_FU_L_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K1_FU_L_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K1_FU_L_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_ID_STR(K1_FU_P3_L_1_P_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K1_FU_P3_L_1_P_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K1_FU_P3_L_1_P_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)))
            );
          }
        }
        #endif
        
        
      
      }
      #endif
      
      #if CACHE_L_CB != 0
      barrier(CLK_LOCAL_MEM_FENCE);
      #endif
      
      
      
      #endif
    }
    #endif
    
    #if K1_L_NUM_FU_R_1 > 1
    #if (K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K1_L_NUM_EXTRA_ELEMENTS_R_1 > 0)
    if (true
    #endif
    #if K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K1_L_NUM_EXTRA_ELEMENTS_R_1 > 0
        && (K1_G_FU_ID_R_1 < (K1_L_NUM_EXTRA_ELEMENTS_R_1 + K1_L_NUM_FU_R_1 - 1) / K1_L_NUM_FU_R_1)
    #endif
    #if (K1_L_NUM_STEPS_R_1 == 0 && K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K1_L_NUM_EXTRA_ELEMENTS_R_1 > 0)
    )
    #endif
    {
      // wait for all FUs to finish computation
      #if   L_CB_RES_DEST_LEVEL == LOCAL && CACHE_L_CB == 0
      barrier(CLK_LOCAL_MEM_FENCE);
      #elif L_CB_RES_DEST_LEVEL == GLOBAL
      barrier(CLK_GLOBAL_MEM_FENCE);
      #endif
      #if L_CB_RES_DEST_LEVEL < LOCAL
      p_cb_offset_l_1 = K1_L_FU_ID_L_1 * K1_P_NUM_FU_L_1;
      
      // phase 1: process private cached iterations in dimension L_1 with all FUs
      #if K1_P_NUM_STEPS_L_1 > 0
      for (size_t p_step_l_1 = 0; p_step_l_1 < K1_P_NUM_STEPS_L_1; ++p_step_l_1) {
        for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K1_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
          MATCH_ID_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1)) = MATCH_ID_STR(K1_FU_L_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          MATCH_WEIGHT_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1)) = MATCH_WEIGHT_STR(K1_FU_L_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          ID_MEASURE_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1)) = ID_MEASURE_STR(K1_FU_L_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
        }
        
        p_cb_offset_l_1 += GET_LOCAL_SIZE_L_1 * K1_P_NUM_CACHED_ITERATIONS_L_1;
      } // end of "p_step_l_1"-loop
      #endif
      // phase 2: process extra private iterations in dimension L_1 with all FUs
      #if K1_P_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0
      {  
        const size_t p_step_l_1 = K1_P_NUM_STEPS_L_1;
        for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K1_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_L_1; ++p_iteration_l_1) {
          MATCH_ID_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1)) = MATCH_ID_STR(K1_FU_L_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          MATCH_WEIGHT_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1)) = MATCH_WEIGHT_STR(K1_FU_L_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          ID_MEASURE_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1)) = ID_MEASURE_STR(K1_FU_L_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
        }
        
        p_cb_offset_l_1 += GET_LOCAL_SIZE_L_1 * K1_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_L_1;
      }
      #endif
      // phase 3: process extra private elements in dimension L_1 with a subset of all FUs
      #if K1_P_NUM_EXTRA_ELEMENTS_L_1 > 0
      if (K1_L_FU_ID_L_1 < (K1_P_NUM_EXTRA_ELEMENTS_L_1 + K1_P_NUM_FU_L_1 - 1) / K1_P_NUM_FU_L_1) {  
        // set step variable for access to res buffer
        const size_t p_step_l_1 = K1_P_NUM_STEPS_L_1 + (K1_P_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0);
        {
          size_t p_iteration_l_1 = 0;
          MATCH_ID_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1)) = MATCH_ID_STR(K1_FU_L_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          MATCH_WEIGHT_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1)) = MATCH_WEIGHT_STR(K1_FU_L_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          ID_MEASURE_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1)) = ID_MEASURE_STR(K1_FU_L_CB_RES_DEST(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
        }
        
      
      }
      #endif
      // wait for all values to be copied into reduction memory
      barrier(CLK_LOCAL_MEM_FENCE);
      #endif
      #if K1_L_NUM_FU_R_1 > 1
      // reduction in dimension R_1
      {
        #if (K1_L_NUM_FU_R_1 & (K1_L_NUM_FU_R_1 - 1)) != 0
        // pre processing: reduce number of values to largest possible power of 2
        size_t stride = pow(2.0f, floor(log2((float) K1_L_NUM_FU_R_1)));
        if (K1_L_FU_ID_R_1 < stride && K1_L_FU_ID_R_1 + stride < K1_L_NUM_FU_R_1) {
          p_cb_offset_l_1 = K1_L_FU_ID_L_1 * K1_P_NUM_FU_L_1;
          
          // phase 1: process private cached iterations in dimension L_1 with all FUs
          #if K1_P_NUM_STEPS_L_1 > 0
          for (size_t p_step_l_1 = 0; p_step_l_1 < K1_P_NUM_STEPS_L_1; ++p_step_l_1) {
            for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K1_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
              #if L_CB_RES_DEST_LEVEL < LOCAL
              // reduction in separate memory location
              combine_in_l_mem(&MATCH_ID_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1)),
                              &MATCH_WEIGHT_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1)),
                              &ID_MEASURE_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1)),
                              &MATCH_ID_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1 + stride)),
                              &MATCH_WEIGHT_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1 + stride)),
                              &ID_MEASURE_STR(K1_L_REDUCTION_MEM(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1 + stride))
              );
              #elif L_CB_RES_DEST_LEVEL == LOCAL
              combine_in_l_cb(&MATCH_ID_STR(K1_RES_L_BUFFER(K1_FU_P_TO_L_INDEX_L_1(K1_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)),
