#define K1_L_NUM_CACHED_ITERATIONS_R_1 (K1_L_CB_SIZE_R_1 / GET_LOCAL_SIZE_R_1)
#define K1_P_NUM_CACHED_ITERATIONS_R_1 (K1_P_CB_SIZE_R_1)

// number of extra cached iterations per FU
#define K1_G_NUM_EXTRA_CACHED_ITERATIONS_R_1 0
#define K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 (K1_G_CB_SIZE_R_1 % (GET_GLOBAL_SIZE_R_1 * K1_L_NUM_CACHED_ITERATIONS_R_1) / GET_GLOBAL_SIZE_R_1)
#define K1_P_NUM_EXTRA_CACHED_ITERATIONS_R_1 ((GET_LOCAL_SIZE_R_1 * K1_L_NUM_CACHED_ITERATIONS_R_1) % (GET_LOCAL_SIZE_R_1 * K1_P_NUM_CACHED_ITERATIONS_R_1) / GET_LOCAL_SIZE_R_1)

// number of extra elements
#define K1_G_NUM_EXTRA_ELEMENTS_R_1 0
#define K1_L_NUM_EXTRA_ELEMENTS_R_1 (K1_G_CB_SIZE_R_1 % (GET_GLOBAL_SIZE_R_1 * K1_L_NUM_CACHED_ITERATIONS_R_1) % GET_GLOBAL_SIZE_R_1)
#define K1_P_NUM_EXTRA_ELEMENTS_R_1 ((GET_LOCAL_SIZE_R_1 * K1_L_NUM_CACHED_ITERATIONS_R_1) % (GET_LOCAL_SIZE_R_1 * K1_P_NUM_CACHED_ITERATIONS_R_1) % GET_LOCAL_SIZE_R_1)

// number of processed elements
#define K1_G_NUM_PROCESSED_ELEMENTS_R_1 ((K1_L_NUM_STEPS_R_1 * K1_L_NUM_CACHED_ITERATIONS_R_1 + K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1) * GET_GLOBAL_SIZE_R_1 + K1_L_NUM_EXTRA_ELEMENTS_R_1)
#define K1_L_NUM_PROCESSED_ELEMENTS_R_1 ((K1_P_NUM_STEPS_R_1 * K1_P_NUM_CACHED_ITERATIONS_R_1 + K1_P_NUM_EXTRA_CACHED_ITERATIONS_R_1) * GET_LOCAL_SIZE_R_1 + K1_P_NUM_EXTRA_ELEMENTS_R_1)
#define K1_P_NUM_PROCESSED_ELEMENTS_R_1 K1_P_NUM_CACHED_ITERATIONS_R_1

// incomplete cache block sizes
#define K1_P_INCOMPLETE_CB_SIZE_IN_COMPLETE_L_CB_R_1 (K1_P_NUM_EXTRA_CACHED_ITERATIONS_R_1)
#define K1_P_INCOMPLETE_CB_SIZE_IN_COMPLETE_G_CB_R_1 (K1_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1)
#define K1_L_INCOMPLETE_CB_SIZE_IN_COMPLETE_G_CB_R_1 (K1_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 * GET_LOCAL_SIZE_R_1)

// number of steps per FU in incomplete cache blocks
#define K1_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1 (K1_L_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1 / K1_P_NUM_CACHED_ITERATIONS_R_1)

// number of cached iterations per FU in incomplete cache blocks
#define K1_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_R_1 (K1_P_INCOMPLETE_CB_SIZE_IN_COMPLETE_L_CB_R_1)
#define K1_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1 (K1_P_INCOMPLETE_CB_SIZE_IN_COMPLETE_G_CB_R_1)
#define K1_L_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1 (K1_L_INCOMPLETE_CB_SIZE_IN_COMPLETE_G_CB_R_1 / GET_LOCAL_SIZE_R_1)

// number of extra cached iterations per FU in incomplete cache blocks
#if K1_P_NUM_CACHED_ITERATIONS_R_1 > 0
#define K1_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1 ((GET_LOCAL_SIZE_R_1 * K1_L_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1) % (GET_LOCAL_SIZE_R_1 * K1_P_NUM_CACHED_ITERATIONS_R_1) / GET_LOCAL_SIZE_R_1)
