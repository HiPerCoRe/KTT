#define K1_FU_G_MEM_I_PROB_CIN(i, j) K1_G_BUFFER_I_PROB_CIN(j)
#if CACHE_L_CB != 0
#define K1_FU_L_MEM_I_PROB_CIN(i, j) K1_L_BUFFER_I_PROB_CIN(j)
#define K1_FU_P3_R_1_L_MEM_I_PROB_CIN(i, j) K1_L_BUFFER_I_PROB_CIN(j)
#else
#define K1_FU_L_MEM_I_PROB_CIN(i, j) K1_FU_G_MEM_I_PROB_CIN(K1_FU_L_TO_G_INDEX_L_1(i), K1_FU_L_TO_G_INDEX_R_1(j))
#define K1_FU_P3_R_1_L_MEM_I_PROB_CIN(i, j) K1_FU_G_MEM_I_PROB_CIN(K1_FU_L_TO_G_INDEX_L_1(i), K1_FU_P3_L_TO_G_INDEX_R_1(j))
#endif
#if CACHE_P_CB != 0
#define K1_FU_P_MEM_I_PROB_CIN(i, j) K1_P_BUFFER_I_PROB_CIN(j)
#define K1_FU_P3_R_1_P_MEM_I_PROB_CIN(i, j) K1_P_BUFFER_I_PROB_CIN(j)
#define K1_FU_P3_IN_COMPLETE_G_CB_R_1_P_MEM_I_PROB_CIN(i, j) K1_P_BUFFER_I_PROB_CIN(j)
#define K1_FU_PP3_R_1_P_MEM_I_PROB_CIN(i, j) K1_P_BUFFER_I_PROB_CIN(j)
#else
#define K1_FU_P_MEM_I_PROB_CIN(i, j) K1_FU_L_MEM_I_PROB_CIN(K1_FU_P_TO_L_INDEX_L_1(i), K1_FU_P_TO_L_INDEX_R_1(j))
#define K1_FU_P3_R_1_P_MEM_I_PROB_CIN(i, j) K1_FU_L_MEM_I_PROB_CIN(K1_FU_P_TO_L_INDEX_L_1(i), K1_FU_P3_P_TO_L_INDEX_R_1(j))
#define K1_FU_P3_IN_COMPLETE_G_CB_R_1_P_MEM_I_PROB_CIN(i, j) K1_FU_L_MEM_I_PROB_CIN(K1_FU_P_TO_L_INDEX_L_1(i), K1_FU_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_R_1(j))
#define K1_FU_PP3_R_1_P_MEM_I_PROB_CIN(i, j) K1_FU_P3_R_1_L_MEM_I_PROB_CIN(K1_FU_P_TO_L_INDEX_L_1(i), K1_FU_PP3_P_TO_L_INDEX_R_1(j))
#endif



// -------------------- result buffer --------------------

// check which levels are used
#if G_CB_RES_DEST_LEVEL == PRIVATE || L_CB_RES_DEST_LEVEL == PRIVATE || P_CB_RES_DEST_LEVEL == PRIVATE
#define K1_P_LEVEL_HAS_RESULTS
#endif
#if G_CB_RES_DEST_LEVEL == LOCAL || L_CB_RES_DEST_LEVEL == LOCAL || P_CB_RES_DEST_LEVEL == LOCAL
#define K1_L_LEVEL_HAS_RESULTS
#endif
#if G_CB_RES_DEST_LEVEL == GLOBAL || L_CB_RES_DEST_LEVEL == GLOBAL || P_CB_RES_DEST_LEVEL == GLOBAL
#define K1_G_LEVEL_HAS_RESULTS
#endif

// ------ PRIVATE ------
#ifdef K1_P_LEVEL_HAS_RESULTS
// construct prefix for res_p
#if G_CB_RES_DEST_LEVEL == PRIVATE
#define K1_RES_P_BUFFER_G_PREFIX_L_1() [l_step_l_1]
#define K1_RES_P_BUFFER_DEF_G_PREFIX_L_1() [K1_L_NUM_STEPS_L_1 + (K1_L_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0) + (K1_L_NUM_EXTRA_ELEMENTS_L_1 > 0)]
#else
#define K1_RES_P_BUFFER_G_PREFIX_L_1()
#define K1_RES_P_BUFFER_DEF_G_PREFIX_L_1()
#endif
#if L_CB_RES_DEST_LEVEL == PRIVATE
#define K1_RES_P_BUFFER_L_PREFIX_L_1() [p_step_l_1]
#define K1_RES_P_BUFFER_DEF_L_PREFIX_L_1() [K1_P_NUM_STEPS_L_1 + (K1_P_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0) + (K1_P_NUM_EXTRA_ELEMENTS_L_1 > 0)]
#else
#define K1_RES_P_BUFFER_L_PREFIX_L_1()
#define K1_RES_P_BUFFER_DEF_L_PREFIX_L_1()
#endif
// construct suffix for res_p
#if   P_CB_RES_DEST_LEVEL == PRIVATE
#define K1_RES_P_BUFFER_SUFFIX_R_1(i) [(i)]
#define K1_RES_P_BUFFER_DEF_SUFFIX_R_1 [K1_P_NUM_FU_R_1]
#endif
// buffer abstraction for res_p
#define K1_RES_P_BUFFER_NAME() res_p
#define K1_RES_P_BUFFER_DEF K1_RES_P_BUFFER_NAME()CONCAT_IN_DESCENDING_OCL_ORDER(K1_RES_P_BUFFER_DEF_G_PREFIX_L_1()K1_RES_P_BUFFER_DEF_L_PREFIX_L_1()[K1_P_CB_SIZE_L_1], K1_RES_P_BUFFER_DEF_SUFFIX_R_1)
#define K1_RES_P_BUFFER(i, j) K1_RES_P_BUFFER_NAME()CONCAT_IN_DESCENDING_OCL_ORDER(K1_RES_P_BUFFER_G_PREFIX_L_1()K1_RES_P_BUFFER_L_PREFIX_L_1()[i], K1_RES_P_BUFFER_SUFFIX_R_1(j))
#endif

// ------ LOCAL ------
#ifdef K1_L_LEVEL_HAS_RESULTS
// construct prefix for res_l
#if G_CB_RES_DEST_LEVEL == LOCAL
#define K1_RES_L_BUFFER_G_PREFIX_L_1() [l_step_l_1]
#define K1_RES_L_BUFFER_DEF_G_PREFIX_L_1() [K1_L_NUM_STEPS_L_1 + (K1_L_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0) + (K1_L_NUM_EXTRA_ELEMENTS_L_1 > 0)]
#else
#define K1_RES_L_BUFFER_G_PREFIX_L_1()
#define K1_RES_L_BUFFER_DEF_G_PREFIX_L_1()
#endif
// construct suffix for res_l
#if   P_CB_RES_DEST_LEVEL == LOCAL
#define K1_RES_L_BUFFER_SUFFIX_R_1(i, j) [(i)][(j)]
#define K1_RES_L_BUFFER_DEF_SUFFIX_R_1 [K1_L_NUM_FU_R_1][K1_P_NUM_FU_R_1]
#elif L_CB_RES_DEST_LEVEL == LOCAL
#define K1_RES_L_BUFFER_SUFFIX_R_1(i, j) [(i)]
#define K1_RES_L_BUFFER_DEF_SUFFIX_R_1 [K1_L_NUM_FU_R_1]
#endif
// buffer abstraction for res_l
#define K1_RES_L_BUFFER_NAME() res_l
#define K1_RES_L_BUFFER_DEF K1_RES_L_BUFFER_NAME()CONCAT_IN_DESCENDING_OCL_ORDER(K1_RES_L_BUFFER_DEF_G_PREFIX_L_1()[K1_L_CB_SIZE_L_1], K1_RES_L_BUFFER_DEF_SUFFIX_R_1)
#define K1_RES_L_BUFFER(i, j, k) K1_RES_L_BUFFER_NAME()CONCAT_IN_DESCENDING_OCL_ORDER(K1_RES_L_BUFFER_G_PREFIX_L_1()[i], K1_RES_L_BUFFER_SUFFIX_R_1(j, k))
#endif

// ------ GLOBAL ------
#ifdef K1_G_LEVEL_HAS_RESULTS
// construct suffix for res_g
#if   P_CB_RES_DEST_LEVEL == GLOBAL
#define K1_RES_G_BUFFER_SUFFIX_R_1(i, j, k) ((i)) * K1_L_NUM_FU_R_1 * K1_P_NUM_FU_R_1 + ((j)) * K1_P_NUM_FU_R_1 + ((k))
#define K1_RES_G_BUFFER_DEF_SUFFIX_R_1 K1_G_NUM_FU_R_1 * K1_L_NUM_FU_R_1 * K1_P_NUM_FU_R_1
#elif L_CB_RES_DEST_LEVEL == GLOBAL
#define K1_RES_G_BUFFER_SUFFIX_R_1(i, j, k) ((i)) * K1_L_NUM_FU_R_1 + ((j))
#define K1_RES_G_BUFFER_DEF_SUFFIX_R_1 K1_G_NUM_FU_R_1 * K1_L_NUM_FU_R_1
#elif G_CB_RES_DEST_LEVEL == GLOBAL
#define K1_RES_G_BUFFER_SUFFIX_R_1(i, j, k) ((i))
#define K1_RES_G_BUFFER_DEF_SUFFIX_R_1 K1_G_NUM_FU_R_1
#endif
// buffer abstraction for res_g
#if (L_CB_RES_DEST_LEVEL == GLOBAL && K1_L_NUM_FU_R_1 > 1) || (P_CB_RES_DEST_LEVEL == GLOBAL && K1_P_NUM_FU_R_1 > 1)
#define K1_RES_G_BUFFER_NAME() res_g
#define K1_RES_G_BUFFER(i, j, k, l) K1_RES_G_BUFFER_NAME()[FLAT_INDEX_IN_DESCENDING_OCL_ORDER(i, K1_RES_G_BUFFER_SUFFIX_R_1(j, k, l), K1_G_CB_SIZE_L_1, K1_RES_G_BUFFER_DEF_SUFFIX_R_1)]
#else
#define K1_RES_G_BUFFER_NAME() int_res
#if K1_G_NUM_FU_R_1 == 1
// if result is final result, use requested ordering of L-dimensions
#define K1_RES_G_BUFFER(i, j, k, l) K1_RES_G_BUFFER_NAME()[(i)]
#else
// else order in descending OpenCL dimension order
#define K1_RES_G_BUFFER(i, j, k, l) K1_RES_G_BUFFER_NAME()[FLAT_INDEX_IN_DESCENDING_OCL_ORDER(i, K1_RES_G_BUFFER_SUFFIX_R_1(j, k, l), K1_G_CB_SIZE_L_1, K1_RES_G_BUFFER_DEF_SUFFIX_R_1)]
#endif
#endif
#endif

// determine memory destination for results
#if   P_CB_RES_DEST_LEVEL == PRIVATE
#define K1_P_CB_RES_DEST(i) K1_RES_P_BUFFER(i, K1_P_FU_ID_R_1)
#define K1_P3_L_1_P_CB_RES_DEST(i) K1_RES_P_BUFFER(i, K1_P_FU_ID_R_1)
#define K1_P3_IN_COMPLETE_G_CB_L_1_P_CB_RES_DEST(i) K1_RES_P_BUFFER(i, K1_P_FU_ID_R_1)
#define K1_PP3_L_1_P_CB_RES_DEST(i) K1_RES_P_BUFFER(i, K1_P_FU_ID_R_1)
#elif P_CB_RES_DEST_LEVEL == LOCAL
#define K1_P_CB_RES_DEST(i) K1_RES_L_BUFFER(K1_P_TO_L_INDEX_L_1(i), K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_P3_L_1_P_CB_RES_DEST(i) K1_RES_L_BUFFER(K1_P3_P_TO_L_INDEX_L_1(i), K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_P3_IN_COMPLETE_G_CB_L_1_P_CB_RES_DEST(i) K1_RES_L_BUFFER(K1_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_1(i), K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_PP3_L_1_P_CB_RES_DEST(i) K1_RES_L_BUFFER(K1_PP3_P_TO_L_INDEX_L_1(i), K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#elif P_CB_RES_DEST_LEVEL == GLOBAL
#define K1_P_CB_RES_DEST(i) K1_RES_G_BUFFER(K1_L_TO_G_INDEX_L_1(K1_P_TO_L_INDEX_L_1(i)), K1_G_FU_ID_R_1, K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_P3_L_1_P_CB_RES_DEST(i) K1_RES_G_BUFFER(K1_L_TO_G_INDEX_L_1(K1_P3_P_TO_L_INDEX_L_1(i)), K1_G_FU_ID_R_1, K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_P3_IN_COMPLETE_G_CB_L_1_P_CB_RES_DEST(i) K1_RES_G_BUFFER(K1_L_TO_G_INDEX_L_1(K1_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_1(i)), K1_G_FU_ID_R_1, K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_PP3_L_1_P_CB_RES_DEST(i) K1_RES_G_BUFFER(K1_P3_L_TO_G_INDEX_L_1(K1_PP3_P_TO_L_INDEX_L_1(i)), K1_G_FU_ID_R_1, K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#endif

#if   L_CB_RES_DEST_LEVEL == PRIVATE
#define K1_L_CB_RES_DEST(i) K1_RES_P_BUFFER(i, K1_P_FU_ID_R_1)
#define K1_P3_L_1_L_CB_RES_DEST(i) K1_RES_P_BUFFER(i, K1_P_FU_ID_R_1)
#elif L_CB_RES_DEST_LEVEL == LOCAL
#define K1_L_CB_RES_DEST(i) K1_RES_L_BUFFER(K1_P_TO_L_INDEX_L_1(i), K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_P3_L_1_L_CB_RES_DEST(i) K1_RES_L_BUFFER(K1_PP3_P_TO_L_INDEX_L_1(i), K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#elif L_CB_RES_DEST_LEVEL == GLOBAL
#define K1_L_CB_RES_DEST(i) K1_RES_G_BUFFER(K1_L_TO_G_INDEX_L_1(K1_P_TO_L_INDEX_L_1(i)), K1_G_FU_ID_R_1, K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_P3_L_1_L_CB_RES_DEST(i) K1_RES_G_BUFFER(K1_P3_L_TO_G_INDEX_L_1(K1_PP3_P_TO_L_INDEX_L_1(i)), K1_G_FU_ID_R_1, K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#endif

#if   P_CB_RES_DEST_LEVEL == PRIVATE
#define K1_FU_P_CB_RES_DEST(i) K1_RES_P_BUFFER(i, K1_P_FU_ID_R_1)
#define K1_FU_P3_L_1_P_CB_RES_DEST(i) K1_RES_P_BUFFER(i, K1_P_FU_ID_R_1)
#define K1_FU_P3_IN_COMPLETE_G_CB_L_1_P_CB_RES_DEST(i) K1_RES_P_BUFFER(i, K1_P_FU_ID_R_1)
#define K1_FU_PP3_L_1_P_CB_RES_DEST(i) K1_RES_P_BUFFER(i, K1_P_FU_ID_R_1)
#elif P_CB_RES_DEST_LEVEL == LOCAL
#define K1_FU_P_CB_RES_DEST(i) K1_RES_L_BUFFER(K1_FU_P_TO_L_INDEX_L_1(i), K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_FU_P3_L_1_P_CB_RES_DEST(i) K1_RES_L_BUFFER(K1_FU_P3_P_TO_L_INDEX_L_1(i), K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_FU_P3_IN_COMPLETE_G_CB_L_1_P_CB_RES_DEST(i) K1_RES_L_BUFFER(K1_FU_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_1(i), K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_FU_PP3_L_1_P_CB_RES_DEST(i) K1_RES_L_BUFFER(K1_FU_PP3_P_TO_L_INDEX_L_1(i), K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#elif P_CB_RES_DEST_LEVEL == GLOBAL
#define K1_FU_P_CB_RES_DEST(i) K1_RES_G_BUFFER(K1_FU_L_TO_G_INDEX_L_1(K1_FU_P_TO_L_INDEX_L_1(i)), K1_G_FU_ID_R_1, K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_FU_P3_L_1_P_CB_RES_DEST(i) K1_RES_G_BUFFER(K1_FU_L_TO_G_INDEX_L_1(K1_FU_P3_P_TO_L_INDEX_L_1(i)), K1_G_FU_ID_R_1, K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_FU_P3_IN_COMPLETE_G_CB_L_1_P_CB_RES_DEST(i) K1_RES_G_BUFFER(K1_FU_L_TO_G_INDEX_L_1(K1_FU_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_1(i)), K1_G_FU_ID_R_1, K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_FU_PP3_L_1_P_CB_RES_DEST(i) K1_RES_G_BUFFER(K1_FU_P3_L_TO_G_INDEX_L_1(K1_FU_PP3_P_TO_L_INDEX_L_1(i)), K1_G_FU_ID_R_1, K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#endif

#if   L_CB_RES_DEST_LEVEL == PRIVATE
#define K1_FU_L_CB_RES_DEST(i) K1_RES_P_BUFFER(i, K1_P_FU_ID_R_1)
#define K1_FU_P3_L_1_L_CB_RES_DEST(i) K1_RES_P_BUFFER(i, K1_P_FU_ID_R_1)
#elif L_CB_RES_DEST_LEVEL == LOCAL
#define K1_FU_L_CB_RES_DEST(i) K1_RES_L_BUFFER(K1_FU_P_TO_L_INDEX_L_1(i), K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_FU_P3_L_1_L_CB_RES_DEST(i) K1_RES_L_BUFFER(K1_FU_PP3_P_TO_L_INDEX_L_1(i), K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#elif L_CB_RES_DEST_LEVEL == GLOBAL
#define K1_FU_L_CB_RES_DEST(i) K1_RES_G_BUFFER(K1_FU_L_TO_G_INDEX_L_1(K1_FU_P_TO_L_INDEX_L_1(i)), K1_G_FU_ID_R_1, K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#define K1_FU_P3_L_1_L_CB_RES_DEST(i) K1_RES_G_BUFFER(K1_FU_P3_L_TO_G_INDEX_L_1(K1_FU_PP3_P_TO_L_INDEX_L_1(i)), K1_G_FU_ID_R_1, K1_L_FU_ID_R_1, K1_P_FU_ID_R_1)
#endif

// check if seperate memory for reduction is needed
// will only be checked for local level, because of constraints for OpenCL
#if L_CB_RES_DEST_LEVEL < LOCAL
#define K1_L_REDUCTION_MEM_NAME() l_reduction_mem
#define K1_L_REDUCTION_MEM(i, j) K1_L_REDUCTION_MEM_NAME()CONCAT_IN_DESCENDING_OCL_ORDER([i], [(j)])
#endif

// buffer abstraction for kernel_res buffer
#if K1_G_NUM_FU_R_1 == 1
// if result is final result, use requested ordering of L-dimensions
#define K1_KERNEL_RES_BUFFER(i, j) int_res[(i)]
#else
// else order in descending OpenCL dimension order
#define K1_KERNEL_RES_BUFFER(i, j) int_res[FLAT_INDEX_IN_DESCENDING_OCL_ORDER(i, j, K1_G_CB_SIZE_L_1, K1_G_NUM_FU_R_1)]
#endif

#define K1_G_KERNEL_RES(i) K1_KERNEL_RES_BUFFER(i, K1_G_FU_ID_R_1)
#define K1_L_KERNEL_RES(i) K1_G_KERNEL_RES(K1_L_TO_G_INDEX_L_1(i))
#define K1_P3_L_1_L_KERNEL_RES(i) K1_G_KERNEL_RES(K1_P3_L_TO_G_INDEX_L_1(i))
#define K1_P_KERNEL_RES(i) K1_L_KERNEL_RES(K1_P_TO_L_INDEX_L_1(i))
#define K1_P3_L_1_P_KERNEL_RES(i) K1_L_KERNEL_RES(K1_P3_P_TO_L_INDEX_L_1(i))
#define K1_P3_IN_COMPLETE_G_CB_L_1_P_KERNEL_RES(i) K1_L_KERNEL_RES(K1_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_1(i))
#define K1_PP3_L_1_P_KERNEL_RES(i) K1_P3_L_1_L_KERNEL_RES(K1_PP3_P_TO_L_INDEX_L_1(i))
#define K1_FU_G_KERNEL_RES(i) K1_KERNEL_RES_BUFFER(i, K1_G_FU_ID_R_1)
#define K1_FU_L_KERNEL_RES(i) K1_FU_G_KERNEL_RES(K1_FU_L_TO_G_INDEX_L_1(i))
#define K1_FU_P3_L_1_L_KERNEL_RES(i) K1_FU_G_KERNEL_RES(K1_FU_P3_L_TO_G_INDEX_L_1(i))
#define K1_FU_P_KERNEL_RES(i) K1_FU_L_KERNEL_RES(K1_FU_P_TO_L_INDEX_L_1(i))
#define K1_FU_P3_L_1_P_KERNEL_RES(i) K1_FU_L_KERNEL_RES(K1_FU_P3_P_TO_L_INDEX_L_1(i))
#define K1_FU_P3_IN_COMPLETE_G_CB_L_1_P_KERNEL_RES(i) K1_FU_L_KERNEL_RES(K1_FU_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_1(i))
#define K1_FU_PP3_L_1_P_KERNEL_RES(i) K1_FU_P3_L_1_L_KERNEL_RES(K1_FU_PP3_P_TO_L_INDEX_L_1(i))
// =============== end of macro definitions per buffer ========================

// =============== scalar function ============================================

// helper macros for prepending macro values with strings
#define CONCAT_(x, y) x ## y
#define CONCAT(x, y) CONCAT_(x, y)
#define MATCH_ID_STR(x) CONCAT(match_id_, x)
#define MATCH_WEIGHT_STR(x) CONCAT(match_weight_, x)
#define ID_MEASURE_STR(x) CONCAT(id_measure_, x)

// determine pointer types and buffer names for result helper functions
#if   P_CB_RES_DEST_LEVEL == PRIVATE
#define K1_P_CB_RES_POINTER_TYPE __private
#define K1_P_CB_RES_BUFFER_NAME K1_RES_P_BUFFER_NAME()
#elif P_CB_RES_DEST_LEVEL == LOCAL
#define K1_P_CB_RES_POINTER_TYPE __local
#define K1_P_CB_RES_BUFFER_NAME K1_RES_L_BUFFER_NAME()
#elif P_CB_RES_DEST_LEVEL == GLOBAL
#define K1_P_CB_RES_POINTER_TYPE __global
#define K1_P_CB_RES_BUFFER_NAME K1_RES_G_BUFFER_NAME()
#endif

#if   L_CB_RES_DEST_LEVEL == PRIVATE
#define K1_L_CB_RES_POINTER_TYPE __private
#define K1_L_CB_RES_BUFFER_NAME K1_RES_P_BUFFER_NAME()
#elif L_CB_RES_DEST_LEVEL == LOCAL
#define K1_L_CB_RES_POINTER_TYPE __local
#define K1_L_CB_RES_BUFFER_NAME K1_RES_L_BUFFER_NAME()
#elif L_CB_RES_DEST_LEVEL == GLOBAL
#define K1_L_CB_RES_POINTER_TYPE __global
#define K1_L_CB_RES_BUFFER_NAME K1_RES_G_BUFFER_NAME()
#endif

#if   G_CB_RES_DEST_LEVEL == PRIVATE
#define K1_G_CB_RES_POINTER_TYPE __private
#define K1_G_CB_RES_BUFFER_NAME K1_RES_P_BUFFER_NAME()
#elif G_CB_RES_DEST_LEVEL == LOCAL
#define K1_G_CB_RES_POINTER_TYPE __local
#define K1_G_CB_RES_BUFFER_NAME K1_RES_L_BUFFER_NAME()
#elif G_CB_RES_DEST_LEVEL == GLOBAL
#define K1_G_CB_RES_POINTER_TYPE __global
#define K1_G_CB_RES_BUFFER_NAME K1_RES_G_BUFFER_NAME()
#endif

typedef struct {
  char str[46];
} str46;
typedef struct {
  char values[2];
} chr2;
typedef struct {
  double values[8];
} dbl8;

inline bool eq_str46(const char a[46], const char b[46]) {
  int c = 0;
  while (c < 46 && a[c] == b[c]) {
    c++;
  }
  return c == 46;
}

#if CACHE_P_CB != 0
inline bool eq_str46_2(__private char const * const a, __private char const * const b) {
  int c = 0;
  while (c < 46 && a[c] == b[c]) {
    c++;
  }
  return c == 46;
}
#elif CACHE_L_CB != 0
inline bool eq_str46_2(__local char const * const a, __local char const * const b) {
  int c = 0;
  while (c < 46 && a[c] == b[c]) {
    c++;
  }
  return c == 46;
}
#else
inline bool eq_str46_2(__global char const * const a, __global char const * const b) {
  int c = 0;
  while (c < 46 && a[c] == b[c]) {
    c++;
  }
  return c == 46;
}
#endif

inline double calculatePartWeight(const str46 n_input,
                                  const str46 i_input,
                                  const double pm, const double puFirst, const double puSecond) {
  //calculatePartWeight
  if (puSecond != 0.0) {
    //refresh pu
    double pu = (puFirst < puSecond) ? puFirst : puSecond;

    //check for equality
    if (eq_str46(n_input.str, i_input.str)) {
      //add part weight
      return (log(pm / pu) / log(2.0));
    } else {
      return (log((1 - pm) / (1 - pu)) / log(2.0));
    }
  }
  return 0.0;
}

inline double calculatePartWeightOnly(const str46 n_input,
                                      const str46 i_input,
                                      const double pm, const double puFirst, const double puSecond) {
  //calculatePartWeightOnly
  if (puSecond != 0.0) {
    //refresh pu
    double pu = (puFirst < puSecond) ? puFirst : puSecond;

    //check for equality
    if (eq_str46(n_input.str, i_input.str)) {
      //add part weight
      return (log(pm / pu) / log(2.0));
    }
  }
  return 0.0;
}

inline double calculatePartWeightFirstname(const str46 n_input,
                                           const str46 i_input,
                                           const char fn_group,
                                           const double pm, const double puFirst, const double puSecond) {
  //calculatePartWeight
  if (puSecond != 0.0) {
    //refresh pu
    double pu = (puFirst < puSecond) ? puFirst : puSecond;

    //check for equality
    if (fn_group || eq_str46(n_input.str, i_input.str)) {
      //add part weight
      return (log(pm / pu) / log(2.0));
    } else {
      return (log((1 - pm) / (1 - pu)) / log(2.0));
    }
  }
  return 0.0;
}

inline double calculatePartWeightOnlyFirstname(const str46 n_input,
                                               const str46 i_input,
                                               const char fn_group,
                                               const double pm, const double puFirst, const double puSecond) {
  //calculatePartWeightOnly
  if (puSecond != 0.0) {
    //refresh pu
    double pu = (puFirst < puSecond) ? puFirst : puSecond;

    //check for equality
    if (fn_group || eq_str46(n_input.str, i_input.str)) {
      //add part weight
      return (log(pm / pu) / log(2.0));
    }
  }
  return 0.0;
}

inline double calculatePartWeightBirthname(const str46 n_input,
                                           const str46 i_input,
                                           const str46 i_lastname1, const str46 i_lastname2, const str46 i_lastname3,
                                           const double pm, const double puFirst, const double puSecond) {
  //calculatePartWeight
  if (puSecond != 0.0 &&
      //check if birthname is not in lastnames
      !(eq_str46(i_input.str, i_lastname1.str) ||
        eq_str46(i_input.str, i_lastname2.str) ||
        eq_str46(i_input.str, i_lastname3.str))) {
    //refresh pu
    double pu = (puFirst < puSecond) ? puFirst : puSecond;

    //check for equality
    if (eq_str46(n_input.str, i_input.str)) {
      //add part weight
      return (log(pm / pu) / log(2.0));
    } else {
      return (log((1 - pm) / (1 - pu)) / log(2.0));
    }
  }
  return 0.0;
}

inline double calculatePartWeightOnlyBirthname(const str46 n_input,
                                               const str46 i_input,
                                               const str46 i_lastname1, const str46 i_lastname2, const str46 i_lastname3,
                                               const double pm, const double puFirst, const double puSecond) {
  //calculatePartWeightOnly
  if (puSecond != 0.0 &&
      //check if birthname is not in lastnames
      !(eq_str46(i_input.str, i_lastname1.str) ||
        eq_str46(i_input.str, i_lastname2.str) ||
        eq_str46(i_input.str, i_lastname3.str))) {
    //refresh pu
    double pu = (puFirst < puSecond) ? puFirst : puSecond;

    //check for equality
    if (eq_str46(n_input.str, i_input.str)) {
      //add part weight
      return (log(pm / pu) / log(2.0));
    }
  }
  return 0.0;
}

inline double calculateCryptoPartLastnames(const str46 n_input1, const str46 n_input2, const str46 n_input3,
                                           const str46 i_input1, const str46 i_input2, const str46 i_input3,
                                           const double n_prob1, const double n_prob2, const double n_prob3,
                                           const double i_prob1, const double i_prob2, const double i_prob3,
                                           const double pm) {
  //result
  double weight = 0.0;

  //partweights for lastname1
  double puFirst = n_prob1;
  double puSecond;

  //if pu's != 0.0, attributes are also != 0
  if (puFirst != 0.0) {
    //partweight for part1
    puSecond = i_prob1;
    weight += calculatePartWeight(n_input1, i_input1, pm, puFirst, puSecond);

    //partweightonly for part2
    puSecond = i_prob2;
    weight += calculatePartWeightOnly(n_input1, i_input2, pm, puFirst, puSecond);

    //partweightonly for part3
    puSecond = i_prob3;
    weight += calculatePartWeightOnly(n_input1, i_input3, pm, puFirst, puSecond);
  }

  //partweights for lastname2
  puFirst = n_prob2;
  if (puFirst != 0.0) {
    //partweight for part2
    puSecond = i_prob2;
    weight += calculatePartWeight(n_input2, i_input2, pm, puFirst, puSecond);

    //partweightonly for part1
    puSecond = i_prob1;
    weight += calculatePartWeightOnly(n_input2, i_input1, pm, puFirst, puSecond);

    //partweightonly for part3
    puSecond = i_prob3;
    weight += calculatePartWeightOnly(n_input2, i_input3, pm, puFirst, puSecond);
  }

  //partweights for lastname3
  puFirst = n_prob3;
  if (puFirst != 0.0) {
    //partweight for part3
    puSecond = i_prob3;
    weight += calculatePartWeight(n_input3, i_input3, pm, puFirst, puSecond);

    //partweightonly for part1
    puSecond = i_prob1;
    weight += calculatePartWeightOnly(n_input3, i_input1, pm, puFirst, puSecond);

    //partweightonly for part2
    puSecond = i_prob2;
    weight += calculatePartWeightOnly(n_input3, i_input2, pm, puFirst, puSecond);
  }

  return weight;
}

inline double calculateCryptoPartFirstnames(const str46 n_input1, const str46 n_input2, const str46 n_input3,
                                            const str46 i_input1, const str46 i_input2, const str46 i_input3,
                                            const double n_prob1, const double n_prob2, const double n_prob3,
                                            const double i_prob1, const double i_prob2, const double i_prob3,
                                            const char n_group1, const char n_group2, const char n_group3,
                                            const char i_group1, const char i_group2, const char i_group3,
                                            const double pm) {
  //result
  double weight = 0.0;

  //partweights for firstname1
  double puFirst = n_prob1;
  double puSecond;

  //if pu's != 0.0, attributes are also != 0
  if (puFirst != 0.0) {
    //same firstname group for: firstname1 equals firstname1
    char sameGroup = n_group1 == i_group1;

    //partweight for part1
    puSecond = i_prob1;
    weight += calculatePartWeightFirstname(n_input1, i_input1, sameGroup, pm, puFirst, puSecond);

    //same firstname group for: firstname1 equals firstname2
    sameGroup = n_group1 == i_group2;

    //partweightonly for part2
    puSecond = i_prob2;
    weight += calculatePartWeightOnlyFirstname(n_input1, i_input2, sameGroup, pm, puFirst, puSecond);

    //same firstname group for: firstname1 equals firstname3
    sameGroup = n_group1 == i_group3;

    //partweightonly for part3
    puSecond = i_prob3;
    weight += calculatePartWeightOnlyFirstname(n_input1, i_input3, sameGroup, pm, puFirst, puSecond);
  }

  //partweights for firstname2
  puFirst = n_prob2;
  if (puFirst != 0.0) {
    //same firstname group for: firstname2 equals firstname2
    char sameGroup = n_group2 == i_group2;

    //partweight for part2
    puSecond = i_prob2;
    weight += calculatePartWeightFirstname(n_input2, i_input2, sameGroup, pm, puFirst, puSecond);

    //same firstname group for: firstname2 equals firstname1 (same as firstname1 equals firstname2)
    sameGroup = n_group2 == i_group1;

    //partweightonly for part1
    puSecond = i_prob1;
    weight += calculatePartWeightOnlyFirstname(n_input2, i_input1, sameGroup, pm, puFirst, puSecond);

    //same firstname group for: firstname2 equals firstname3
    sameGroup = n_group2 == i_group3;

    //partweightonly for part3
    puSecond = i_prob3;
    weight += calculatePartWeightOnlyFirstname(n_input2, i_input3, sameGroup, pm, puFirst, puSecond);
  }

  //partweights for firstname3
  puFirst = n_prob3;
  if (puFirst != 0.0) {
    //same firstname group for: firstname3 equals firstname3
    char sameGroup = n_group3 == i_group3;

    //partweight for part3
    puSecond = i_prob3;
    weight += calculatePartWeightFirstname(n_input3, i_input3, sameGroup, pm, puFirst, puSecond);

    //same firstname group for: firstname3 equals firstname1 (same as firstname1 equals firstname3)
    sameGroup = n_group3 == i_group1;

    //partweightonly for part1
    puSecond = i_prob1;
    weight += calculatePartWeightOnlyFirstname(n_input3, i_input1, sameGroup, pm, puFirst, puSecond);

    //same firstname group for: firstname3 equals firstname2 (same as firstname2 equals firstname3)
    sameGroup = n_group3 == i_group2;

    //partweightonly for part2
    puSecond = i_prob2;
    weight += calculatePartWeightOnlyFirstname(n_input3, i_input2, sameGroup, pm, puFirst, puSecond);
  }

  return weight;
}

inline double calculateCryptoPartBirthnames(const str46 n_input1, const str46 n_input2, const str46 n_input3,
                                            const str46 i_input1, const str46 i_input2, const str46 i_input3,
                                            const str46 i_lastname1, const str46 i_lastname2, const str46 i_lastname3,
                                            const double n_prob1, const double n_prob2, const double n_prob3,
                                            const double i_prob1, const double i_prob2, const double i_prob3,
                                            const double pm) {
  //result
  double weight = 0.0;

  //partweights for birthnames
  double puFirst = n_prob1;
  double puSecond;

  //if pu's != 0.0, attributes are also != 0
  if (puFirst != 0.0) {
    //partweight for part1
    puSecond = i_prob1;
    weight += calculatePartWeightBirthname(n_input1, i_input1,
                                           i_lastname1, i_lastname2, i_lastname3,
                                           pm, puFirst, puSecond);

    //partweightonly for part2
    puSecond = i_prob2;
    weight += calculatePartWeightOnlyBirthname(n_input1, i_input2,
                                               i_lastname1, i_lastname2, i_lastname3,
                                               pm, puFirst, puSecond);

    //partweightonly for part3
    puSecond = i_prob3;
    weight += calculatePartWeightOnlyBirthname(n_input1, i_input3,
                                               i_lastname1, i_lastname2, i_lastname3,
                                               pm, puFirst, puSecond);
  }

  //partweights for lastname2
  puFirst = n_prob2;
  if (puFirst != 0.0) {
    //partweight for part2
    puSecond = i_prob2;
    weight += calculatePartWeightBirthname(n_input2, i_input2,
                                           i_lastname1, i_lastname2, i_lastname3,
                                           pm, puFirst, puSecond);

    //partweightonly for part1
    puSecond = i_prob1;
    weight += calculatePartWeightOnlyBirthname(n_input2, i_input1,
                                               i_lastname1, i_lastname2, i_lastname3,
                                               pm, puFirst, puSecond);

    //partweightonly for part3
    puSecond = i_prob3;
    weight += calculatePartWeightOnlyBirthname(n_input2, i_input3,
                                               i_lastname1, i_lastname2, i_lastname3,
                                               pm, puFirst, puSecond);
  }

  //partweights for lastname3
  puFirst = n_prob3;
  if (puFirst != 0.0) {
    //partweight for part3
    puSecond = i_prob3;
    weight += calculatePartWeightBirthname(n_input3, i_input3,
                                           i_lastname1, i_lastname2, i_lastname3,
                                           pm, puFirst, puSecond);

    //partweightonly for part1
    puSecond = i_prob1;
    weight += calculatePartWeightOnlyBirthname(n_input3, i_input1,
                                               i_lastname1, i_lastname2, i_lastname3,
                                               pm, puFirst, puSecond);

    //partweightonly for part2
    puSecond = i_prob2;
    weight += calculatePartWeightOnlyBirthname(n_input3, i_input2,
                                               i_lastname1, i_lastname2, i_lastname3,
                                               pm, puFirst, puSecond);
  }

  return weight;
}
inline void f(const dbl8 probM_val,
              const long n_id_val,
              const str46 n_lastname1_val,
              const str46 n_lastname2_val,
              const str46 n_lastname3_val,
              const str46 n_firstname1_val,
              const str46 n_firstname2_val,
              const str46 n_firstname3_val,
              const long n_firstname_group1_val,
              const long n_firstname_group2_val,
              const long n_firstname_group3_val,
              const str46 n_birthname1_val,
              const str46 n_birthname2_val,
              const str46 n_birthname3_val,
              const str46 n_birthday_val,
              const chr2 n_gender_val,
              const int n_birthmonth_val,
              const int n_birthyear_val,
              const int n_cin_val,
              const double n_prob_lastname1_val,
              const double n_prob_lastname2_val,
              const double n_prob_lastname3_val,
              const double n_prob_firstname1_val,
              const double n_prob_firstname2_val,
              const double n_prob_firstname3_val,
              const double n_prob_birthname1_val,
              const double n_prob_birthname2_val,
              const double n_prob_birthname3_val,
              const double n_prob_birthday_val,
              const double n_prob_gender_val,
              const double n_prob_birthmonth_val,
              const double n_prob_birthyear_val,
              const double n_prob_cin_val,
              const long i_id_val,
              const str46 i_lastname1_val,
              const str46 i_lastname2_val,
              const str46 i_lastname3_val,
              const str46 i_firstname1_val,
              const str46 i_firstname2_val,
              const str46 i_firstname3_val,
              const long i_firstname_group1_val,
              const long i_firstname_group2_val,
              const long i_firstname_group3_val,
              const str46 i_birthname1_val,
              const str46 i_birthname2_val,
              const str46 i_birthname3_val,
              const str46 i_birthday_val,
              const chr2 i_gender_val,
              const int i_birthmonth_val,
              const int i_birthyear_val,
              const int i_cin_val,
              const double i_prob_lastname1_val,
              const double i_prob_lastname2_val,
              const double i_prob_lastname3_val,
              const double i_prob_firstname1_val,
              const double i_prob_firstname2_val,
              const double i_prob_firstname3_val,
              const double i_prob_birthname1_val,
              const double i_prob_birthname2_val,
              const double i_prob_birthname3_val,
              const double i_prob_birthday_val,
              const double i_prob_gender_val,
              const double i_prob_birthmonth_val,
              const double i_prob_birthyear_val,
              const double i_prob_cin_val,
              K1_P_CB_RES_POINTER_TYPE long * const match_id_res,
              K1_P_CB_RES_POINTER_TYPE double * const match_weight_res,
              K1_P_CB_RES_POINTER_TYPE int * const id_measure_res) {
  if (n_id_val == i_id_val) {
  	*match_id_res = 0;
    *match_weight_res = 0.0;
    *id_measure_res = 0;
  	return;
  }

  // blockrun
  bool match = false;
  if (!match) {
    match = eq_str46(n_lastname1_val.str, i_lastname1_val.str)
            && eq_str46(n_firstname1_val.str, i_firstname1_val.str)
            && eq_str46(n_birthday_val.str, i_birthday_val.str)
            && n_birthmonth_val == i_birthmonth_val
            && n_birthyear_val == i_birthyear_val;
  }
  if (!match) {
    match = eq_str46(n_lastname1_val.str, i_lastname1_val.str)
            && n_gender_val.values[0] == i_gender_val.values[0]
            && n_gender_val.values[1] == i_gender_val.values[1]
            && n_cin_val == i_cin_val;
  }
  if (!match) {
    match = eq_str46(n_firstname1_val.str, i_firstname1_val.str)
            && eq_str46(n_birthday_val.str, i_birthday_val.str);
  }
  if (!match) {
    match = eq_str46(n_firstname1_val.str, i_firstname1_val.str)
            && n_birthmonth_val == i_birthmonth_val;
  }
  if (!match) {
    match = eq_str46(n_firstname1_val.str, i_firstname1_val.str)
            && n_birthyear_val == i_birthyear_val;
  }
  if (!match) {
    match = eq_str46(n_birthday_val.str, i_birthday_val.str)
            && n_birthmonth_val == i_birthmonth_val
            && n_birthyear_val == i_birthyear_val;
  }
  if (!match) {
    match = eq_str46(n_lastname1_val.str, i_lastname1_val.str);
  }
  if (!match) {
  	*match_id_res = 0;
  	*match_weight_res = 0.0;
    *id_measure_res = 0;
  	return;
  }

  // calculate weight
  double weight = 0.0;
  double pm;
  {
    pm = probM_val.values[0];
    weight += calculateCryptoPartLastnames(n_lastname1_val, n_lastname2_val, n_lastname3_val,
                                           i_lastname1_val, i_lastname2_val, i_lastname3_val,
                                           n_prob_lastname1_val, n_prob_lastname2_val, n_prob_lastname3_val,
                                           i_prob_lastname1_val, i_prob_lastname2_val, i_prob_lastname3_val,
                                           pm);
  }
  {
    pm = probM_val.values[1];
    weight += calculateCryptoPartFirstnames(n_firstname1_val, n_firstname2_val, n_firstname3_val,
                                            i_firstname1_val, i_firstname2_val, i_firstname3_val,
                                            n_prob_firstname1_val, n_prob_firstname2_val, n_prob_firstname3_val,
                                            i_prob_firstname1_val, i_prob_firstname2_val, i_prob_firstname3_val,
                                            n_firstname_group1_val, n_firstname_group2_val, n_firstname_group3_val,
                                            i_firstname_group1_val, i_firstname_group2_val, i_firstname_group3_val,
                                            pm);
  }
  {
    pm = probM_val.values[2];
    weight += calculateCryptoPartBirthnames(n_birthname1_val, n_birthname2_val, n_birthname3_val,
                                            i_birthname1_val, i_birthname2_val, i_birthname3_val,
                                            i_lastname1_val, i_lastname2_val, i_lastname3_val,
                                            n_prob_birthname1_val, n_prob_birthname2_val, n_prob_birthname3_val,
                                            i_prob_birthname1_val, i_prob_birthname2_val, i_prob_birthname3_val,
                                            pm);
  }
  {
    pm = probM_val.values[3];
    double puFirst = n_prob_birthday_val;
    if (puFirst != 0.0) {
      double puSecond = i_prob_birthday_val;
      weight += calculatePartWeight(n_birthday_val, i_birthday_val, pm, puFirst, puSecond);
    }
  }
  {
    pm = probM_val.values[4];
    double puFirst = n_prob_birthmonth_val;
    double puSecond = i_prob_birthmonth_val;
    if (puFirst != 0.0 && puSecond != 0.0) {
      double pu = (puFirst < puSecond) ? puFirst : puSecond;
      //check for equality
      if (n_birthmonth_val == i_birthmonth_val) {
        //add part weight
        weight += (log(pm / pu) / log(2.0));
      } else {
        weight += (log((1 - pm) / (1 - pu)) / log(2.0));
      }
    }
  }
  {
    pm = probM_val.values[5];
    double puFirst = n_prob_birthyear_val;
    double puSecond = i_prob_birthyear_val;
    if (puFirst != 0.0 && puSecond != 0.0) {
      double pu = (puFirst < puSecond) ? puFirst : puSecond;
      //check for equality
      if (n_birthyear_val == i_birthyear_val) {
        //add part weight
        weight += (log(pm / pu) / log(2.0));
      } else {
        weight += (log((1 - pm) / (1 - pu)) / log(2.0));
      }
    }
  }
  {
    pm = probM_val.values[6];
    double puFirst = n_prob_gender_val;
    double puSecond = i_prob_gender_val;
    if (puFirst != 0.0 && puSecond != 0.0) {
      double pu = (puFirst < puSecond) ? puFirst : puSecond;
      //check for equality
      if (n_gender_val.values[0] == i_gender_val.values[0]
          && n_gender_val.values[1] == i_gender_val.values[1]) {
        //add part weight
        weight += (log(pm / pu) / log(2.0));
      } else {
        weight += (log((1 - pm) / (1 - pu)) / log(2.0));
      }
    }
  }
  {
    pm = probM_val.values[7];
    double puFirst = n_prob_cin_val;
    double puSecond = i_prob_cin_val;
    if (puFirst != 0.0 && puSecond != 0.0) {
      double pu = (puFirst < puSecond) ? puFirst : puSecond;
      //check for equality
      if (n_cin_val == i_cin_val) {
        //add part weight
        weight += (log(pm / pu) / log(2.0));
      } else {
        weight += (log((1 - pm) / (1 - pu)) / log(2.0));
      }
    } else {
      //this part of the program is a transfered bug of the norm programm!!!
      //double pu = 1.0E-7;
      //weight += (log((1 - pm) / (1 - pu)) / log(2.0));
    }
  }

  // calculate identity measure
  int id_measure = 0;
  if (n_prob_lastname1_val == 0.0 || i_prob_lastname1_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_lastname1_val.str, i_lastname1_val.str))
    ++id_measure;
  if (n_prob_lastname2_val == 0.0 || i_prob_lastname2_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_lastname2_val.str, i_lastname2_val.str))
    ++id_measure;
  if (n_prob_lastname3_val == 0.0 || i_prob_lastname3_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_lastname3_val.str, i_lastname3_val.str))
    ++id_measure;
  if (n_prob_firstname1_val == 0.0 || i_prob_firstname1_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_firstname1_val.str, i_firstname1_val.str))
    ++id_measure;
  if (n_prob_firstname2_val == 0.0 || i_prob_firstname2_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_firstname2_val.str, i_firstname2_val.str))
    ++id_measure;
  if (n_prob_firstname3_val == 0.0 || i_prob_firstname3_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_firstname3_val.str, i_firstname3_val.str))
    ++id_measure;
  if (n_prob_birthname1_val == 0.0 || i_prob_birthname1_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_birthname1_val.str, i_birthname1_val.str))
    ++id_measure;
  if (n_prob_birthname2_val == 0.0 || i_prob_birthname2_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_birthname2_val.str, i_birthname2_val.str))
    ++id_measure;
  if (n_prob_birthname3_val == 0.0 || i_prob_birthname3_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_birthname3_val.str, i_birthname3_val.str))
    ++id_measure;
  if (n_prob_birthday_val == 0.0 || i_prob_birthday_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_birthday_val.str, i_birthday_val.str))
    ++id_measure;
  if (n_prob_gender_val == 0.0 || i_prob_gender_val == 0.0)
    ++id_measure;
  else if (n_gender_val.values[0] == i_gender_val.values[0]
        && n_gender_val.values[1] == i_gender_val.values[1])
    ++id_measure;
  if (n_prob_birthmonth_val == 0.0 || i_prob_birthmonth_val == 0.0)
    ++id_measure;
  else if (n_birthmonth_val == i_birthmonth_val)
    ++id_measure;
  if (n_prob_birthyear_val == 0.0 || i_prob_birthyear_val == 0.0)
    ++id_measure;
  else if (n_birthyear_val == i_birthyear_val)
    ++id_measure;
  if (n_prob_cin_val == 0.0 || i_prob_cin_val == 0.0)
    ++id_measure;
  else if (n_cin_val == i_cin_val)
    ++id_measure;

  if (id_measure == 14 || weight >= 15.0) {
  	*match_id_res = i_id_val;
    *match_weight_res = weight;
    *id_measure_res = id_measure;
  }
}
inline void r(const dbl8 probM_val,
              const long n_id_val, // TODO id notwendig?
              const str46 n_lastname1_val,
              const str46 n_lastname2_val,
              const str46 n_lastname3_val,
              const str46 n_firstname1_val,
              const str46 n_firstname2_val,
              const str46 n_firstname3_val,
              const long n_firstname_group1_val,
              const long n_firstname_group2_val,
              const long n_firstname_group3_val,
              const str46 n_birthname1_val,
              const str46 n_birthname2_val,
              const str46 n_birthname3_val,
              const str46 n_birthday_val,
              const chr2 n_gender_val,
              const int n_birthmonth_val,
              const int n_birthyear_val,
              const int n_cin_val,
              const double n_prob_lastname1_val,
              const double n_prob_lastname2_val,
              const double n_prob_lastname3_val,
              const double n_prob_firstname1_val,
              const double n_prob_firstname2_val,
              const double n_prob_firstname3_val,
              const double n_prob_birthname1_val,
              const double n_prob_birthname2_val,
              const double n_prob_birthname3_val,
              const double n_prob_birthday_val,
              const double n_prob_gender_val,
              const double n_prob_birthmonth_val,
              const double n_prob_birthyear_val,
              const double n_prob_cin_val,
              const long i_id_val,
              const str46 i_lastname1_val,
              const str46 i_lastname2_val,
              const str46 i_lastname3_val,
              const str46 i_firstname1_val,
              const str46 i_firstname2_val,
              const str46 i_firstname3_val,
              const long i_firstname_group1_val,
              const long i_firstname_group2_val,
              const long i_firstname_group3_val,
              const str46 i_birthname1_val,
              const str46 i_birthname2_val,
              const str46 i_birthname3_val,
              const str46 i_birthday_val,
              const chr2 i_gender_val,
              const int i_birthmonth_val,
              const int i_birthyear_val,
              const int i_cin_val,
              const double i_prob_lastname1_val,
              const double i_prob_lastname2_val,
              const double i_prob_lastname3_val,
              const double i_prob_firstname1_val,
              const double i_prob_firstname2_val,
              const double i_prob_firstname3_val,
              const double i_prob_birthname1_val,
              const double i_prob_birthname2_val,
              const double i_prob_birthname3_val,
              const double i_prob_birthday_val,
              const double i_prob_gender_val,
              const double i_prob_birthmonth_val,
              const double i_prob_birthyear_val,
              const double i_prob_cin_val,
              K1_P_CB_RES_POINTER_TYPE long * const match_id_res,
              K1_P_CB_RES_POINTER_TYPE double * const match_weight_res,
              K1_P_CB_RES_POINTER_TYPE int * const id_measure_res) {
  // calculate weight
  double weight = 0.0;
  double pm;
  {
    pm = probM_val.values[0];
    weight += calculateCryptoPartLastnames(n_lastname1_val, n_lastname2_val, n_lastname3_val,
                                           i_lastname1_val, i_lastname2_val, i_lastname3_val,
                                           n_prob_lastname1_val, n_prob_lastname2_val, n_prob_lastname3_val,
                                           i_prob_lastname1_val, i_prob_lastname2_val, i_prob_lastname3_val,
                                           pm);
  }
  {
    pm = probM_val.values[1];
    weight += calculateCryptoPartFirstnames(n_firstname1_val, n_firstname2_val, n_firstname3_val,
                                            i_firstname1_val, i_firstname2_val, i_firstname3_val,
                                            n_prob_firstname1_val, n_prob_firstname2_val, n_prob_firstname3_val,
                                            i_prob_firstname1_val, i_prob_firstname2_val, i_prob_firstname3_val,
                                            n_firstname_group1_val, n_firstname_group2_val, n_firstname_group3_val,
                                            i_firstname_group1_val, i_firstname_group2_val, i_firstname_group3_val,
                                            pm);
  }
  {
    pm = probM_val.values[2];
    weight += calculateCryptoPartBirthnames(n_birthname1_val, n_birthname2_val, n_birthname3_val,
                                            i_birthname1_val, i_birthname2_val, i_birthname3_val,
                                            i_lastname1_val, i_lastname2_val, i_lastname3_val,
                                            n_prob_birthname1_val, n_prob_birthname2_val, n_prob_birthname3_val,
                                            i_prob_birthname1_val, i_prob_birthname2_val, i_prob_birthname3_val,
                                            pm);
  }
  {
    pm = probM_val.values[3];
    double puFirst = n_prob_birthday_val;
    if (puFirst != 0.0) {
      double puSecond = i_prob_birthday_val;
      weight += calculatePartWeight(n_birthday_val, i_birthday_val, pm, puFirst, puSecond);
    }
  }
  {
    pm = probM_val.values[4];
    double puFirst = n_prob_birthmonth_val;
    double puSecond = i_prob_birthmonth_val;
    if (puFirst != 0.0 && puSecond != 0.0) {
      double pu = (puFirst < puSecond) ? puFirst : puSecond;
      //check for equality
      if (n_birthmonth_val == i_birthmonth_val) {
        //add part weight
        weight += (log(pm / pu) / log(2.0));
      } else {
        weight += (log((1 - pm) / (1 - pu)) / log(2.0));
      }
    }
  }
  {
    pm = probM_val.values[5];
    double puFirst = n_prob_birthyear_val;
    double puSecond = i_prob_birthyear_val;
    if (puFirst != 0.0 && puSecond != 0.0) {
      double pu = (puFirst < puSecond) ? puFirst : puSecond;
      //check for equality
      if (n_birthyear_val == i_birthyear_val) {
        //add part weight
        weight += (log(pm / pu) / log(2.0));
      } else {
        weight += (log((1 - pm) / (1 - pu)) / log(2.0));
      }
    }
  }
  {
    pm = probM_val.values[6];
    double puFirst = n_prob_gender_val;
    double puSecond = i_prob_gender_val;
    if (puFirst != 0.0 && puSecond != 0.0) {
      double pu = (puFirst < puSecond) ? puFirst : puSecond;
      //check for equality
      if (n_gender_val.values[0] == i_gender_val.values[0]
          && n_gender_val.values[1] == i_gender_val.values[1]) {
        //add part weight
        weight += (log(pm / pu) / log(2.0));
      } else {
        weight += (log((1 - pm) / (1 - pu)) / log(2.0));
      }
    }
  }
  {
    pm = probM_val.values[7];
    double puFirst = n_prob_cin_val;
    double puSecond = i_prob_cin_val;
    if (puFirst != 0.0 && puSecond != 0.0) {
      double pu = (puFirst < puSecond) ? puFirst : puSecond;
      //check for equality
      if (n_cin_val == i_cin_val) {
        //add part weight
        weight += (log(pm / pu) / log(2.0));
      } else {
        weight += (log((1 - pm) / (1 - pu)) / log(2.0));
      }
    } else {
      //this part of the program is a transfered bug of the norm programm!!!
      //double pu = 1.0E-7;
      //weight += (log((1 - pm) / (1 - pu)) / log(2.0));
    }
  }

  // calculate identity measure
  int id_measure = 0;
  if (n_prob_lastname1_val == 0.0 || i_prob_lastname1_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_lastname1_val.str, i_lastname1_val.str))
    ++id_measure;
  if (n_prob_lastname2_val == 0.0 || i_prob_lastname2_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_lastname2_val.str, i_lastname2_val.str))
    ++id_measure;
  if (n_prob_lastname3_val == 0.0 || i_prob_lastname3_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_lastname3_val.str, i_lastname3_val.str))
    ++id_measure;
  if (n_prob_firstname1_val == 0.0 || i_prob_firstname1_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_firstname1_val.str, i_firstname1_val.str))
    ++id_measure;
  if (n_prob_firstname2_val == 0.0 || i_prob_firstname2_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_firstname2_val.str, i_firstname2_val.str))
    ++id_measure;
  if (n_prob_firstname3_val == 0.0 || i_prob_firstname3_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_firstname3_val.str, i_firstname3_val.str))
    ++id_measure;
  if (n_prob_birthname1_val == 0.0 || i_prob_birthname1_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_birthname1_val.str, i_birthname1_val.str))
    ++id_measure;
  if (n_prob_birthname2_val == 0.0 || i_prob_birthname2_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_birthname2_val.str, i_birthname2_val.str))
    ++id_measure;
  if (n_prob_birthname3_val == 0.0 || i_prob_birthname3_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_birthname3_val.str, i_birthname3_val.str))
    ++id_measure;
  if (n_prob_birthday_val == 0.0 || i_prob_birthday_val == 0.0)
    ++id_measure;
  else if (eq_str46(n_birthday_val.str, i_birthday_val.str))
    ++id_measure;
  if (n_prob_gender_val == 0.0 || i_prob_gender_val == 0.0)
    ++id_measure;
  else if (n_gender_val.values[0] == i_gender_val.values[0]
        && n_gender_val.values[1] == i_gender_val.values[1])
    ++id_measure;
  if (n_prob_birthmonth_val == 0.0 || i_prob_birthmonth_val == 0.0)
    ++id_measure;
  else if (n_birthmonth_val == i_birthmonth_val)
    ++id_measure;
  if (n_prob_birthyear_val == 0.0 || i_prob_birthyear_val == 0.0)
    ++id_measure;
  else if (n_birthyear_val == i_birthyear_val)
    ++id_measure;
  if (n_prob_cin_val == 0.0 || i_prob_cin_val == 0.0)
    ++id_measure;
  else if (n_cin_val == i_cin_val)
    ++id_measure;
  if ((weight >= 15.0 || id_measure == 14) && (weight > *match_weight_res)) {
    *match_id_res = i_id_val;
    *match_weight_res = weight;
    *id_measure_res = id_measure;
  }
}
// =============== end of scalar function =====================================

inline void combine_in_p_cb(K1_P_CB_RES_POINTER_TYPE long * const match_id_res_a,
							K1_P_CB_RES_POINTER_TYPE double * const match_weight_res_a,
							K1_P_CB_RES_POINTER_TYPE int * const id_measure_res_a,
							K1_P_CB_RES_POINTER_TYPE long const * const match_id_res_b,
							K1_P_CB_RES_POINTER_TYPE double const * const match_weight_res_b,
							K1_P_CB_RES_POINTER_TYPE int const * const id_measure_res_b) {
  if (((*id_measure_res_a) != 14 && (*id_measure_res_b) == 14)
    || (*match_weight_res_b) > (*match_weight_res_a)) {
    *match_id_res_a = *match_id_res_b;
    *match_weight_res_a = *match_weight_res_b;
    *id_measure_res_a = *id_measure_res_b;
  }
}

