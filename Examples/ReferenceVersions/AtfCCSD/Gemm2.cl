                const size_t BUFFER_INT_RES_INDEX_1(p_index_l_1, p_index_l_2, p_index_r_1) = (flat_index / (BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, 1, 1))) % BUFFER_INT_RES_INDEX_1(K2_P_NUM_PROCESSED_ELEMENTS_L_1, 1, 1);
                const size_t BUFFER_INT_RES_INDEX_0(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index % BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, 1, 1);
                #else
                const size_t p_index_l_1 = flat_index / (1 * 1);
                const size_t p_index_l_2 = (flat_index / (1)) % 1;
                const size_t p_index_r_1 = flat_index % 1;
                #endif
                K2_PP3_L_2_P3_IN_COMPLETE_G_CB_R_1_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_P3_L_2_L_MEM_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_L_2(p_index_l_2), K2_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_R_1(p_index_r_1));
              }
              #endif
              // ---------- end of P caching -------------
              
              for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
                {
                  size_t p_iteration_l_2 = 0;
                  {
                    size_t p_iteration_r_1 = 0;
                    // process one mda element
                    K2_PP3_L_2_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) += K2_PP3_L_2_P3_IN_COMPLETE_G_CB_R_1_P_MEM_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
                  
                  }
                }
              }  
              #endif
            }
            #endif
            
            // ---------- reduction --------------------
            // will never be necessary on this level
            // because K2_P_NUM_FU_R == 1 for OpenCL
            // ---------- end of reduction -------------
            
            // move results upwards in memory hierarchy
            #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL || K2_P_NUM_FU_R_1 > 1
            #if K2_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1 == 0 && K2_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1 == 0 && K2_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_R_1 > 0
            if (K2_L_FU_ID_R_1 < (K2_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_R_1 + K2_P_NUM_FU_R_1 - 1) / K2_P_NUM_FU_R_1)
            #endif
            {
              
              for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1)
                {
                  size_t p_iteration_l_2 = 0;
                  K2_P3_L_2_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) = K2_PP3_L_2_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
                }
            }
            #endif
          
          }
        
        } // end of "p_step_l_1"-loop
        #endif
        // phase 2: process extra private iterations in dimension L_1 with all FUs
