              for (size_t step = 0; step < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI; ++step) {
                const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
                #if CACHE_L_CB != 0
                const size_t BUFFER_INT_RES_INDEX_2(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index / (BUFFER_INT_RES_INDEX_1(1, 1, 1) * BUFFER_INT_RES_INDEX_0(1, 1, 1));
                const size_t BUFFER_INT_RES_INDEX_1(p_index_l_1, p_index_l_2, p_index_r_1) = (flat_index / (BUFFER_INT_RES_INDEX_0(1, 1, 1))) % BUFFER_INT_RES_INDEX_1(1, 1, 1);
                const size_t BUFFER_INT_RES_INDEX_0(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index % BUFFER_INT_RES_INDEX_0(1, 1, 1);
                #else
                const size_t p_index_l_1 = flat_index / (1 * 1);
                const size_t p_index_l_2 = (flat_index / (1)) % 1;
                const size_t p_index_r_1 = flat_index % 1;
                #endif
                K2_P3_L_1_P3_IN_COMPLETE_G_CB_L_2_P3_R_1_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_L_MEM_INT_RES(K2_P3_P_TO_L_INDEX_L_1(p_index_l_1), K2_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_2(p_index_l_2), K2_P3_P_TO_L_INDEX_R_1(p_index_r_1));
              }
              if (K2_P_FLAT_WI_ID < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) % K2_P_FLAT_NUM_WI) {
                const size_t flat_index = K2_P_FLAT_WI_ID + (((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
                #if CACHE_L_CB != 0
                const size_t BUFFER_INT_RES_INDEX_2(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index / (BUFFER_INT_RES_INDEX_1(1, 1, 1) * BUFFER_INT_RES_INDEX_0(1, 1, 1));
                const size_t BUFFER_INT_RES_INDEX_1(p_index_l_1, p_index_l_2, p_index_r_1) = (flat_index / (BUFFER_INT_RES_INDEX_0(1, 1, 1))) % BUFFER_INT_RES_INDEX_1(1, 1, 1);
                const size_t BUFFER_INT_RES_INDEX_0(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index % BUFFER_INT_RES_INDEX_0(1, 1, 1);
                #else
                const size_t p_index_l_1 = flat_index / (1 * 1);
                const size_t p_index_l_2 = (flat_index / (1)) % 1;
                const size_t p_index_r_1 = flat_index % 1;
                #endif
                K2_P3_L_1_P3_IN_COMPLETE_G_CB_L_2_P3_R_1_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_L_MEM_INT_RES(K2_P3_P_TO_L_INDEX_L_1(p_index_l_1), K2_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_2(p_index_l_2), K2_P3_P_TO_L_INDEX_R_1(p_index_r_1));
              }
              #endif
              // ---------- end of P caching -------------
              
              {
                size_t p_iteration_l_1 = 0;
                {
                  size_t p_iteration_l_2 = 0;
                  {
                    size_t p_iteration_r_1 = 0;
                    // process one mda element
                    K2_P3_L_1_P3_IN_COMPLETE_G_CB_L_2_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) += K2_P3_L_1_P3_IN_COMPLETE_G_CB_L_2_P3_R_1_P_MEM_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
                  
                  }
                }
              }  
              #endif
            }
            #endif
            
            // ---------- reduction --------------------
            // will never be necessary on this level
            // because K2_P_NUM_FU_R == 1 for OpenCL
            // ---------- end of reduction -------------
            
            // move results upwards in memory hierarchy
            #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL || K2_P_NUM_FU_R_1 > 1
            #if K2_P_NUM_STEPS_R_1 == 0 && K2_P_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K2_P_NUM_EXTRA_ELEMENTS_R_1 > 0
            if (K2_L_FU_ID_R_1 < (K2_P_NUM_EXTRA_ELEMENTS_R_1 + K2_P_NUM_FU_R_1 - 1) / K2_P_NUM_FU_R_1)
            #endif
            {
              
              {
                size_t p_iteration_l_1 = 0;
                {
                  size_t p_iteration_l_2 = 0;
                  K2_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) += K2_P3_L_1_P3_IN_COMPLETE_G_CB_L_2_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
                }
              }
            }
            #endif
          
          }
          #endif
        }
        #endif
        
        
        // wait for all WIs to finish computation on local cache block
        #if CACHE_L_CB != 0
        barrier(CLK_LOCAL_MEM_FENCE);
        #endif
      } // end of "l_step_r_1"-loop
      #endif
      #endif
      // phase 2: process extra local iterations in dimension R_1 with all FUs
      #if K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 > 0
      {  
        const size_t l_step_r_1 = K2_L_NUM_STEPS_R_1;  
        #if K2_L_NUM_STEPS_R_1 == 0
        // ---------- L caching --------------------
        #if CACHE_L_CB != 0
        #if ((K2_L_NUM_PROCESSED_ELEMENTS_L_1 * K2_L_NUM_PROCESSED_ELEMENTS_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_R_1) / K2_L_NUM_PROCESSED_ELEMENTS_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2 / K2_L_NUM_PROCESSED_ELEMENTS_R_1 * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1) / K2_L_FLAT_NUM_WI > 0
        for (size_t step = 0; step < ((K2_L_NUM_PROCESSED_ELEMENTS_L_1 * K2_L_NUM_PROCESSED_ELEMENTS_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_R_1) / K2_L_NUM_PROCESSED_ELEMENTS_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2 / K2_L_NUM_PROCESSED_ELEMENTS_R_1 * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1) / K2_L_FLAT_NUM_WI; ++step) {
          const size_t flat_index = K2_L_FLAT_WI_ID + step * K2_L_FLAT_NUM_WI;
          const size_t l_index_l_1 = flat_index / (K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1);
          const size_t l_index_l_2 = (flat_index / (K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1)) % K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2;
          const size_t l_index_r_1 = flat_index % K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1;
          K2_L_MEM_INT_RES(l_index_l_1, l_index_l_2, l_index_r_1) = K2_G_MEM_INT_RES(K2_L_TO_G_INDEX_L_1(l_index_l_1), K2_L_TO_G_INDEX_L_2(l_index_l_2), K2_L_TO_G_INDEX_R_1(l_index_r_1));
        }
        #endif
        #if ((K2_L_NUM_PROCESSED_ELEMENTS_L_1 * K2_L_NUM_PROCESSED_ELEMENTS_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_R_1) / K2_L_NUM_PROCESSED_ELEMENTS_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2 / K2_L_NUM_PROCESSED_ELEMENTS_R_1 * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1) % K2_L_FLAT_NUM_WI > 0
        if (K2_L_FLAT_WI_ID < ((K2_L_NUM_PROCESSED_ELEMENTS_L_1 * K2_L_NUM_PROCESSED_ELEMENTS_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_R_1) / K2_L_NUM_PROCESSED_ELEMENTS_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2 / K2_L_NUM_PROCESSED_ELEMENTS_R_1 * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1) % K2_L_FLAT_NUM_WI) {
          const size_t flat_index = K2_L_FLAT_WI_ID + (((K2_L_NUM_PROCESSED_ELEMENTS_L_1 * K2_L_NUM_PROCESSED_ELEMENTS_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_R_1) / K2_L_NUM_PROCESSED_ELEMENTS_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2 / K2_L_NUM_PROCESSED_ELEMENTS_R_1 * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1) / K2_L_FLAT_NUM_WI) * K2_L_FLAT_NUM_WI;
          const size_t l_index_l_1 = flat_index / (K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1);
          const size_t l_index_l_2 = (flat_index / (K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1)) % K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2;
          const size_t l_index_r_1 = flat_index % K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1;
          K2_L_MEM_INT_RES(l_index_l_1, l_index_l_2, l_index_r_1) = K2_G_MEM_INT_RES(K2_L_TO_G_INDEX_L_1(l_index_l_1), K2_L_TO_G_INDEX_L_2(l_index_l_2), K2_L_TO_G_INDEX_R_1(l_index_r_1));
        }
        #endif
        barrier(CLK_LOCAL_MEM_FENCE);
        #endif
        // ---------- end of L caching -------------
        
        // phase 1: process private cached iterations in dimension L_1 with all FUs
        #if K2_P_NUM_STEPS_L_1 > 0
        for (size_t p_step_l_1 = 0; p_step_l_1 < K2_P_NUM_STEPS_L_1; ++p_step_l_1) {
          // phase 1: process private cached iterations in dimension L_2 with all FUs
          #if K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2 > 0
          for (size_t p_step_l_2 = 0; p_step_l_2 < K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2; ++p_step_l_2) {
            // phase 1: process private cached iterations in dimension R_1 with all FUs
            #if K2_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1 > 0
            size_t p_step_r_1 = 0;
            // ---------- P caching --------------------
            #if CACHE_P_CB != 0
            #if (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI > 0
            for (size_t step = 0; step < (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI; ++step) {
              const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
              #if CACHE_L_CB != 0
              const size_t BUFFER_INT_RES_INDEX_2(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index / (BUFFER_INT_RES_INDEX_1(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1) * BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1));
              const size_t BUFFER_INT_RES_INDEX_1(p_index_l_1, p_index_l_2, p_index_r_1) = (flat_index / (BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1))) % BUFFER_INT_RES_INDEX_1(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
              const size_t BUFFER_INT_RES_INDEX_0(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index % BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
              #else
              const size_t p_index_l_1 = flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1);
              const size_t p_index_l_2 = (flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_R_1)) % K2_P_NUM_PROCESSED_ELEMENTS_L_2;
              const size_t p_index_r_1 = flat_index % K2_P_NUM_PROCESSED_ELEMENTS_R_1;
              #endif
              K2_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_L_MEM_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_L_2(p_index_l_2), K2_P_TO_L_INDEX_R_1(p_index_r_1));
            }
            #endif
            #if (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) % K2_P_FLAT_NUM_WI > 0
            if (K2_P_FLAT_WI_ID < (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) % K2_P_FLAT_NUM_WI) {
              const size_t flat_index = K2_P_FLAT_WI_ID + ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
              #if CACHE_L_CB != 0
              const size_t BUFFER_INT_RES_INDEX_2(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index / (BUFFER_INT_RES_INDEX_1(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1) * BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1));
              const size_t BUFFER_INT_RES_INDEX_1(p_index_l_1, p_index_l_2, p_index_r_1) = (flat_index / (BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1))) % BUFFER_INT_RES_INDEX_1(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
              const size_t BUFFER_INT_RES_INDEX_0(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index % BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
              #else
              const size_t p_index_l_1 = flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1);
              const size_t p_index_l_2 = (flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_R_1)) % K2_P_NUM_PROCESSED_ELEMENTS_L_2;
              const size_t p_index_r_1 = flat_index % K2_P_NUM_PROCESSED_ELEMENTS_R_1;
              #endif
              K2_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_L_MEM_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_L_2(p_index_l_2), K2_P_TO_L_INDEX_R_1(p_index_r_1));
            }
            #endif
            #endif
            // ---------- end of P caching -------------
            
            for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
              for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K2_P_NUM_CACHED_ITERATIONS_L_2; ++p_iteration_l_2) {
                size_t p_iteration_r_1 = 0;
                // process one mda element
                K2_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) = K2_P_MEM_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
                
                #if K2_P_NUM_CACHED_ITERATIONS_R_1 > 1
                for (p_iteration_r_1 = 1; p_iteration_r_1 < K2_P_NUM_CACHED_ITERATIONS_R_1; ++p_iteration_r_1) {
                  // process one mda element
                  K2_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) += K2_P_MEM_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
                
                }
                #endif
                
              
              }
            }
            #if K2_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1 > 1
            for (p_step_r_1 = 1; p_step_r_1 < K2_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1; ++p_step_r_1) {
              // ---------- P caching --------------------
              #if CACHE_P_CB != 0
              #if (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI > 0
              for (size_t step = 0; step < (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI; ++step) {
                const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
                #if CACHE_L_CB != 0
                const size_t BUFFER_INT_RES_INDEX_2(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index / (BUFFER_INT_RES_INDEX_1(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1) * BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1));
                const size_t BUFFER_INT_RES_INDEX_1(p_index_l_1, p_index_l_2, p_index_r_1) = (flat_index / (BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1))) % BUFFER_INT_RES_INDEX_1(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
                const size_t BUFFER_INT_RES_INDEX_0(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index % BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
                #else
                const size_t p_index_l_1 = flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1);
                const size_t p_index_l_2 = (flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_R_1)) % K2_P_NUM_PROCESSED_ELEMENTS_L_2;
                const size_t p_index_r_1 = flat_index % K2_P_NUM_PROCESSED_ELEMENTS_R_1;
                #endif
                K2_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_L_MEM_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_L_2(p_index_l_2), K2_P_TO_L_INDEX_R_1(p_index_r_1));
              }
              #endif
              #if (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) % K2_P_FLAT_NUM_WI > 0
