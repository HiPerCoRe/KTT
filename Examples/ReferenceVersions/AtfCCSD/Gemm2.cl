              }
            }
          }
          #endif
        
        }
        #endif
      }
      
      
      
      // wait for all WIs to finish computation on local cache block
      #if CACHE_L_CB != 0
      barrier(CLK_LOCAL_MEM_FENCE);
      #endif
      #if K2_L_NUM_STEPS_R_1 > 1
      for (l_step_r_1 = 1; l_step_r_1 < K2_L_NUM_STEPS_R_1; ++l_step_r_1) {
        // ---------- L caching --------------------
        #if CACHE_L_CB != 0
        for (size_t step = 0; step < ((K2_L_NUM_PROCESSED_ELEMENTS_L_1 * K2_L_NUM_PROCESSED_ELEMENTS_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_R_1) / K2_L_NUM_PROCESSED_ELEMENTS_L_1 * ((((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) <= 0) * 0) + (((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) > 0) * ((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) <= K2_L_NUM_FU_L_1) * (K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1)) + (((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) > K2_L_NUM_FU_L_1) * K2_L_NUM_FU_L_1)) / K2_L_NUM_PROCESSED_ELEMENTS_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2) / K2_L_FLAT_NUM_WI; ++step) {
