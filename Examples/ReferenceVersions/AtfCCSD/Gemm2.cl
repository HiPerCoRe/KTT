          const size_t l_index_l_1 = flat_index / (((((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) <= 0) * 0) + (((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) > 0) * ((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) <= K2_L_NUM_FU_L_2) * (K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2)) + (((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) > K2_L_NUM_FU_L_2) * K2_L_NUM_FU_L_2)) * ((((K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) <= 0) * 0) + (((K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) > 0) * ((K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) <= K2_L_NUM_FU_R_1) * (K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1)) + (((K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) > K2_L_NUM_FU_R_1) * K2_L_NUM_FU_R_1)));
          const size_t l_index_l_2 = (flat_index / (((((K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) <= 0) * 0) + (((K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) > 0) * ((K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) <= K2_L_NUM_FU_R_1) * (K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1)) + (((K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) > K2_L_NUM_FU_R_1) * K2_L_NUM_FU_R_1)))) % ((((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) <= 0) * 0) + (((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) > 0) * ((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) <= K2_L_NUM_FU_L_2) * (K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2)) + (((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) > K2_L_NUM_FU_L_2) * K2_L_NUM_FU_L_2));
          const size_t l_index_r_1 = flat_index % ((((K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) <= 0) * 0) + (((K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) > 0) * ((K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) <= K2_L_NUM_FU_R_1) * (K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1)) + (((K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) > K2_L_NUM_FU_R_1) * K2_L_NUM_FU_R_1));
          K2_P3_L_1_P3_L_2_P3_R_1_L_MEM_INT_RES(l_index_l_1, l_index_l_2, l_index_r_1) = K2_G_MEM_INT_RES(K2_P3_L_TO_G_INDEX_L_1(l_index_l_1), K2_P3_L_TO_G_INDEX_L_2(l_index_l_2), K2_P3_L_TO_G_INDEX_R_1(l_index_r_1));
        }
        barrier(CLK_LOCAL_MEM_FENCE);
        #endif
        // ---------- end of L caching -------------
        
        // parent level in phase 3: process extra private elements in dimension L_1 with a subset of all FUs
        if (K2_L_FU_ID_L_1 < K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) {
          size_t p_step_l_1 = 0;
          // parent level in phase 3: process extra private elements in dimension L_2 with a subset of all FUs
