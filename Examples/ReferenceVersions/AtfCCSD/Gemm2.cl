#define K2_P3_L_2_P_CB_RES_DEST(i, j) K2_RES_L_BUFFER(K2_P_TO_L_INDEX_L_1(i), K2_P3_P_TO_L_INDEX_L_2(j), K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)
#define K2_P3_IN_COMPLETE_G_CB_L_2_P_CB_RES_DEST(i, j) K2_RES_L_BUFFER(K2_P_TO_L_INDEX_L_1(i), K2_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_2(j), K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)
