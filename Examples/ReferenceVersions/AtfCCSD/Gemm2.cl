            for (p_step_r_1 = 1; p_step_r_1 < K2_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1; ++p_step_r_1) {
              // ---------- P caching --------------------
              #if CACHE_P_CB != 0
              #if ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_2) / K2_P_FLAT_NUM_WI > 0
              for (size_t step = 0; step < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_2) / K2_P_FLAT_NUM_WI; ++step) {
                const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
                #if CACHE_L_CB != 0
                const size_t BUFFER_INT_RES_INDEX_2(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index / (BUFFER_INT_RES_INDEX_1(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1) * BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_2, K2_P_NUM_PROCESSED_ELEMENTS_R_1));
