                    size_t p_iteration_l_2 = 0;
                    K2_P3_L_2_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) = K2_PP3_L_2_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
                  }
              }
              #endif
            
            }
          
          }
        
        } // end of "p_step_l_1"-loop
        #endif
        // phase 2: process extra private iterations in dimension L_1 with all FUs
        #if K2_P_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0
        {  
          const size_t p_step_l_1 = K2_P_NUM_STEPS_L_1;
          // parent level in phase 3: process extra private elements in dimension L_2 with a subset of all FUs
          if (K2_L_FU_ID_L_2 < K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) {
            size_t p_step_l_2 = 0;
            // parent level in phase 3: process extra private elements in dimension R_1 with a subset of all FUs
            if (K2_L_FU_ID_R_1 < K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) {
              size_t p_step_r_1 = 0;
              // ---------- P caching --------------------
              #if CACHE_P_CB != 0
              #if ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI > 0
              for (size_t step = 0; step < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI; ++step) {
