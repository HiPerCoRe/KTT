                K2_P3_L_1_PP3_R_1_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_P3_R_1_L_MEM_INT_RES(K2_P3_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_L_2(p_index_l_2), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
