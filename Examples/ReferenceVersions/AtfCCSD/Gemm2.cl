                }
                #endif
                
              
              }
            }
            #else
            {
              size_t p_iteration_l_1 = 0;
              {
                size_t p_iteration_l_2 = 0;
                for (size_t p_iteration_r_1 = 0; p_iteration_r_1 < K2_P_NUM_CACHED_ITERATIONS_R_1; ++p_iteration_r_1) {
                  // process one mda element
                  K2_P3_IN_COMPLETE_G_CB_L_1_P3_L_2_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) += K2_P3_IN_COMPLETE_G_CB_L_1_P3_L_2_P_MEM_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
                
                }
              }
            }
            #endif
            #if K2_P_NUM_STEPS_R_1 > 1
            for (p_step_r_1 = 1; p_step_r_1 < K2_P_NUM_STEPS_R_1; ++p_step_r_1) {
              // ---------- P caching --------------------
              #if CACHE_P_CB != 0
              for (size_t step = 0; step < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * 1) / K2_P_FLAT_NUM_WI; ++step) {
