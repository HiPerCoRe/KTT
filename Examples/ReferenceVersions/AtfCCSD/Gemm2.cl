          const size_t l_index_l_2 = (flat_index / (K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1)) % ((((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) <= 0) * 0) + (((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) > 0) * ((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) <= K2_L_NUM_FU_L_2) * (K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2)) + (((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) > K2_L_NUM_FU_L_2) * K2_L_NUM_FU_L_2));
