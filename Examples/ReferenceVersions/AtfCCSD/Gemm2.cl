          // set step variable for access to res buffer
          const size_t p_step_l_1 = K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_1 + (K2_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_1 > 0);
