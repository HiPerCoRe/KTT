#define K2_P3_L_1_P3_L_2_P_CB_RES_DEST(i, j) K2_RES_P_BUFFER(i, j, K2_P_FU_ID_R_1)
#define K2_P3_L_1_P3_IN_COMPLETE_G_CB_L_2_P_CB_RES_DEST(i, j) K2_RES_P_BUFFER(i, j, K2_P_FU_ID_R_1)
#define K2_P3_L_1_PP3_L_2_P_CB_RES_DEST(i, j) K2_RES_P_BUFFER(i, j, K2_P_FU_ID_R_1)
