#define K2_P3_L_2_P_KERNEL_RES(i, j) K2_L_KERNEL_RES(K2_P_TO_L_INDEX_L_1(i), K2_P3_P_TO_L_INDEX_L_2(j))
#define K2_P3_IN_COMPLETE_G_CB_L_2_P_KERNEL_RES(i, j) K2_L_KERNEL_RES(K2_P_TO_L_INDEX_L_1(i), K2_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_2(j))
#define K2_PP3_L_2_P_KERNEL_RES(i, j) K2_P3_L_2_L_KERNEL_RES(K2_P_TO_L_INDEX_L_1(i), K2_PP3_P_TO_L_INDEX_L_2(j))
#define K2_P3_L_1_P_KERNEL_RES(i, j) K2_L_KERNEL_RES(K2_P3_P_TO_L_INDEX_L_1(i), K2_P_TO_L_INDEX_L_2(j))
#define K2_P3_L_1_P3_L_2_P_KERNEL_RES(i, j) K2_L_KERNEL_RES(K2_P3_P_TO_L_INDEX_L_1(i), K2_P3_P_TO_L_INDEX_L_2(j))
#define K2_P3_L_1_P3_IN_COMPLETE_G_CB_L_2_P_KERNEL_RES(i, j) K2_L_KERNEL_RES(K2_P3_P_TO_L_INDEX_L_1(i), K2_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_2(j))
#define K2_P3_L_1_PP3_L_2_P_KERNEL_RES(i, j) K2_P3_L_2_L_KERNEL_RES(K2_P3_P_TO_L_INDEX_L_1(i), K2_PP3_P_TO_L_INDEX_L_2(j))
#define K2_P3_IN_COMPLETE_G_CB_L_1_P_KERNEL_RES(i, j) K2_L_KERNEL_RES(K2_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_1(i), K2_P_TO_L_INDEX_L_2(j))
#define K2_P3_IN_COMPLETE_G_CB_L_1_P3_L_2_P_KERNEL_RES(i, j) K2_L_KERNEL_RES(K2_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_1(i), K2_P3_P_TO_L_INDEX_L_2(j))
#define K2_P3_IN_COMPLETE_G_CB_L_1_P3_IN_COMPLETE_G_CB_L_2_P_KERNEL_RES(i, j) K2_L_KERNEL_RES(K2_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_1(i), K2_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_2(j))
#define K2_P3_IN_COMPLETE_G_CB_L_1_PP3_L_2_P_KERNEL_RES(i, j) K2_P3_L_2_L_KERNEL_RES(K2_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_1(i), K2_PP3_P_TO_L_INDEX_L_2(j))
#define K2_PP3_L_1_P_KERNEL_RES(i, j) K2_P3_L_1_L_KERNEL_RES(K2_PP3_P_TO_L_INDEX_L_1(i), K2_P_TO_L_INDEX_L_2(j))
#define K2_PP3_L_1_P3_L_2_P_KERNEL_RES(i, j) K2_P3_L_1_L_KERNEL_RES(K2_PP3_P_TO_L_INDEX_L_1(i), K2_P3_P_TO_L_INDEX_L_2(j))
