            if (K2_P_FLAT_WI_ID < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1) % K2_P_FLAT_NUM_WI) {
