                const size_t p_index_l_2 = (flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1)) % K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_2;
                const size_t p_index_r_1 = flat_index % K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1;
