                const size_t BUFFER_INT_RES_INDEX_1(p_index_l_1, p_index_l_2, p_index_r_1) = (flat_index / (BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1))) % BUFFER_INT_RES_INDEX_1(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1);
                const size_t BUFFER_INT_RES_INDEX_0(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index % BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1);
                #else
                const size_t p_index_l_1 = flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1);
                const size_t p_index_l_2 = (flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1)) % K2_P_NUM_PROCESSED_ELEMENTS_L_2;
                const size_t p_index_r_1 = flat_index % K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1;
                #endif
                K2_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_L_MEM_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_L_2(p_index_l_2), K2_P_TO_L_INDEX_R_1(p_index_r_1));
              }
              #endif
              #if ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1) % K2_P_FLAT_NUM_WI > 0
              if (K2_P_FLAT_WI_ID < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1) % K2_P_FLAT_NUM_WI) {
                const size_t flat_index = K2_P_FLAT_WI_ID + (((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
                #if CACHE_L_CB != 0
                const size_t BUFFER_INT_RES_INDEX_2(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index / (BUFFER_INT_RES_INDEX_1(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1) * BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1));
                const size_t BUFFER_INT_RES_INDEX_1(p_index_l_1, p_index_l_2, p_index_r_1) = (flat_index / (BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1))) % BUFFER_INT_RES_INDEX_1(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1);
                const size_t BUFFER_INT_RES_INDEX_0(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index % BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1);
                #else
