          #else
          const size_t DESCENDING_L_DIMS_1(l_index_l_1, l_index_l_2) = flat_index / (DESCENDING_L_DIMS_0(((((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) <= 0) * 0) + (((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) > 0) * ((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) <= K2_L_NUM_FU_L_1) * (K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1)) + (((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) > K2_L_NUM_FU_L_1) * K2_L_NUM_FU_L_1)), K2_L_NUM_PROCESSED_ELEMENTS_L_2));
          const size_t DESCENDING_L_DIMS_0(l_index_l_1, l_index_l_2) = flat_index % DESCENDING_L_DIMS_0(((((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) <= 0) * 0) + (((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) > 0) * ((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) <= K2_L_NUM_FU_L_1) * (K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1)) + (((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) > K2_L_NUM_FU_L_1) * K2_L_NUM_FU_L_1)), K2_L_NUM_PROCESSED_ELEMENTS_L_2);
          #endif
          K2_P3_L_1_L_KERNEL_RES(l_index_l_1, l_index_l_2) =
