                K2_PP3_L_2_PP3_R_1_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_P3_L_2_P3_R_1_L_MEM_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_L_2(p_index_l_2), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
              }
              #endif
              #endif
              // ---------- end of P caching -------------
              
              #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL
              for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_L_1; ++p_iteration_l_1) {
                {
                  size_t p_iteration_l_2 = 0;
                  size_t p_iteration_r_1 = 0;
                  // process one mda element
                  K2_PP3_L_2_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) = K2_PP3_L_2_PP3_R_1_P_MEM_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
                  
                
                }
