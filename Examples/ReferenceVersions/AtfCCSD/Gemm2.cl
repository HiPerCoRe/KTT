                const size_t BUFFER_INT_RES_INDEX_0(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index % BUFFER_INT_RES_INDEX_0(1, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2, 1);
                #else
                const size_t p_index_l_1 = flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2 * 1);
                const size_t p_index_l_2 = (flat_index / (1)) % K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2;
                const size_t p_index_r_1 = flat_index % 1;
                #endif
                K2_PP3_L_1_PP3_R_1_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_P3_L_1_P3_R_1_L_MEM_INT_RES(K2_PP3_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_L_2(p_index_l_2), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
              }
              #endif
              #if ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) % K2_P_FLAT_NUM_WI > 0
              if (K2_P_FLAT_WI_ID < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) % K2_P_FLAT_NUM_WI) {
                const size_t flat_index = K2_P_FLAT_WI_ID + (((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
                #if CACHE_L_CB != 0
                const size_t BUFFER_INT_RES_INDEX_2(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index / (BUFFER_INT_RES_INDEX_1(1, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2, 1) * BUFFER_INT_RES_INDEX_0(1, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2, 1));
                const size_t BUFFER_INT_RES_INDEX_1(p_index_l_1, p_index_l_2, p_index_r_1) = (flat_index / (BUFFER_INT_RES_INDEX_0(1, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2, 1))) % BUFFER_INT_RES_INDEX_1(1, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2, 1);
                const size_t BUFFER_INT_RES_INDEX_0(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index % BUFFER_INT_RES_INDEX_0(1, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2, 1);
                #else
                const size_t p_index_l_1 = flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2 * 1);
                const size_t p_index_l_2 = (flat_index / (1)) % K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2;
                const size_t p_index_r_1 = flat_index % 1;
                #endif
                K2_PP3_L_1_PP3_R_1_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_P3_L_1_P3_R_1_L_MEM_INT_RES(K2_PP3_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_L_2(p_index_l_2), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
              }
              #endif
              #endif
              // ---------- end of P caching -------------
              
              #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL
              {
                size_t p_iteration_l_1 = 0;
                for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2; ++p_iteration_l_2) {
                  size_t p_iteration_r_1 = 0;
                  // process one mda element
                  K2_PP3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) = K2_PP3_L_1_PP3_R_1_P_MEM_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
                  
                
                }
              }
              #else
              {
                size_t p_iteration_l_1 = 0;
                for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2; ++p_iteration_l_2) {
                  {
                    size_t p_iteration_r_1 = 0;
                    // process one mda element
