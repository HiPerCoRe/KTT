      }
      if (K2_L_FLAT_WI_ID < ((K2_L_NUM_PROCESSED_ELEMENTS_L_1 * K2_L_NUM_PROCESSED_ELEMENTS_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_R_1) / K2_L_NUM_PROCESSED_ELEMENTS_L_2 * ((((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) <= 0) * 0) + (((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) > 0) * ((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) <= K2_L_NUM_FU_L_2) * (K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2)) + (((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) > K2_L_NUM_FU_L_2) * K2_L_NUM_FU_L_2))) % K2_L_FLAT_NUM_WI) {
        const size_t flat_index = K2_L_FLAT_WI_ID + (((K2_L_NUM_PROCESSED_ELEMENTS_L_1 * K2_L_NUM_PROCESSED_ELEMENTS_L_2 * K2_L_NUM_PROCESSED_ELEMENTS_R_1) / K2_L_NUM_PROCESSED_ELEMENTS_L_2 * ((((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) <= 0) * 0) + (((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) > 0) * ((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) <= K2_L_NUM_FU_L_2) * (K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2)) + (((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) > K2_L_NUM_FU_L_2) * K2_L_NUM_FU_L_2))) / K2_L_FLAT_NUM_WI) * K2_L_FLAT_NUM_WI;
        const size_t l_index_l_1 = flat_index / (((((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) <= 0) * 0) + (((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) > 0) * ((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) <= K2_L_NUM_FU_L_2) * (K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2)) + (((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) > K2_L_NUM_FU_L_2) * K2_L_NUM_FU_L_2)) * K2_L_NUM_PROCESSED_ELEMENTS_R_1);
        const size_t l_index_l_2 = (flat_index / (K2_L_NUM_PROCESSED_ELEMENTS_R_1)) % ((((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) <= 0) * 0) + (((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) > 0) * ((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) <= K2_L_NUM_FU_L_2) * (K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2)) + (((K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) > K2_L_NUM_FU_L_2) * K2_L_NUM_FU_L_2));
        const size_t l_index_r_1 = flat_index % K2_L_NUM_PROCESSED_ELEMENTS_R_1;
        K2_P3_L_2_L_MEM_INT_RES(l_index_l_1, l_index_l_2, l_index_r_1) = K2_G_MEM_INT_RES(K2_L_TO_G_INDEX_L_1(l_index_l_1), K2_P3_L_TO_G_INDEX_L_2(l_index_l_2), K2_L_TO_G_INDEX_R_1(l_index_r_1));
      }
      barrier(CLK_LOCAL_MEM_FENCE);
      #endif
      // ---------- end of L caching -------------
      
      
      // phase 1: process private cached iterations in dimension L_1 with all FUs
      #if K2_P_NUM_STEPS_L_1 > 0
      for (size_t p_step_l_1 = 0; p_step_l_1 < K2_P_NUM_STEPS_L_1; ++p_step_l_1) {
        // parent level in phase 3: process extra private elements in dimension L_2 with a subset of all FUs
        if (K2_L_FU_ID_L_2 < K2_L_NUM_EXTRA_ELEMENTS_L_2 - K2_G_FU_ID_L_2 * K2_L_NUM_FU_L_2) {
          size_t p_step_l_2 = 0;
          // phase 1: process private cached iterations in dimension R_1 with all FUs
          #if K2_P_NUM_STEPS_R_1 > 0
          size_t p_step_r_1 = 0;
          // ---------- P caching --------------------
          #if CACHE_P_CB != 0
          #if ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * 1) / K2_P_FLAT_NUM_WI > 0
          for (size_t step = 0; step < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * 1) / K2_P_FLAT_NUM_WI; ++step) {
            const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
            const size_t BUFFER_INT_RES_INDEX_2(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index / (BUFFER_INT_RES_INDEX_1(K2_P_NUM_PROCESSED_ELEMENTS_L_1, 1, K2_P_NUM_PROCESSED_ELEMENTS_R_1) * BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, 1, K2_P_NUM_PROCESSED_ELEMENTS_R_1));
            const size_t BUFFER_INT_RES_INDEX_1(p_index_l_1, p_index_l_2, p_index_r_1) = (flat_index / (BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, 1, K2_P_NUM_PROCESSED_ELEMENTS_R_1))) % BUFFER_INT_RES_INDEX_1(K2_P_NUM_PROCESSED_ELEMENTS_L_1, 1, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
            const size_t BUFFER_INT_RES_INDEX_0(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index % BUFFER_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, 1, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
            #else
            const size_t p_index_l_1 = flat_index / (1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1);
            const size_t p_index_l_2 = (flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_R_1)) % 1;
            const size_t p_index_r_1 = flat_index % K2_P_NUM_PROCESSED_ELEMENTS_R_1;
            #endif
            K2_PP3_L_2_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_P3_L_2_L_MEM_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_L_2(p_index_l_2), K2_P_TO_L_INDEX_R_1(p_index_r_1));
          }
          #endif
          #if ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * 1) % K2_P_FLAT_NUM_WI > 0
          if (K2_P_FLAT_WI_ID < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * 1) % K2_P_FLAT_NUM_WI) {
            const size_t flat_index = K2_P_FLAT_WI_ID + (((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * 1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
