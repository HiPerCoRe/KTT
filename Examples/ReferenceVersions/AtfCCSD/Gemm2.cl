                    K2_L_REDUCTION_MEM(K2_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1) += K2_L_REDUCTION_MEM(K2_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1 + stride);
                    #elif L_CB_RES_DEST_LEVEL == LOCAL
                    K2_RES_L_BUFFER(K2_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1, K2_P_FU_ID_R_1) += K2_RES_L_BUFFER(K2_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1);
                    #elif L_CB_RES_DEST_LEVEL == GLOBAL
                    K2_RES_G_BUFFER(K2_P3_L_TO_G_INDEX_L_1(K2_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_L_TO_G_INDEX_L_2(K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1, K2_P_FU_ID_R_1) += K2_RES_G_BUFFER(K2_P3_L_TO_G_INDEX_L_1(K2_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_L_TO_G_INDEX_L_2(K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1);
                    #endif
                  
                  }
                }
              }
              #endif
            }
        
          }
          #if L_CB_RES_DEST_LEVEL <= LOCAL
          barrier(CLK_LOCAL_MEM_FENCE);
          #elif L_CB_RES_DEST_LEVEL == GLOBAL
          barrier(CLK_GLOBAL_MEM_FENCE);
          #endif
        }
        #if L_CB_RES_DEST_LEVEL <= LOCAL
        barrier(CLK_LOCAL_MEM_FENCE);
        #elif L_CB_RES_DEST_LEVEL == GLOBAL
        barrier(CLK_GLOBAL_MEM_FENCE);
        #endif
      }
      #endif
      
      // move results upwards in memory hierarchy
      #if G_CB_RES_DEST_LEVEL > L_CB_RES_DEST_LEVEL || K2_L_NUM_FU_R_1 > 1
      #if K2_L_NUM_STEPS_R_1 == 0 && K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K2_L_NUM_EXTRA_ELEMENTS_R_1 > 0
      if (K2_G_FU_ID_R_1 < (K2_L_NUM_EXTRA_ELEMENTS_R_1 + K2_L_NUM_FU_R_1 - 1) / K2_L_NUM_FU_R_1)
      #endif
      {
        
        #if L_CB_RES_DEST_LEVEL < LOCAL && K2_L_NUM_FU_R_1 == 1
        if (K2_L_FU_ID_R_1 == 0) {
          // parent level in phase 3: process extra private elements in dimension L_1 with a subset of all FUs
          if (K2_L_FU_ID_L_1 < K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) {
            size_t p_step_l_1 = 0;
            // phase 1: process private cached iterations in dimension L_2 with all FUs
            #if K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2 > 0
            for (size_t p_step_l_2 = 0; p_step_l_2 < K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2; ++p_step_l_2) {
              {
                size_t p_iteration_l_1 = 0;
                for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K2_P_NUM_CACHED_ITERATIONS_L_2; ++p_iteration_l_2)
                  K2_PP3_L_1_P_KERNEL_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) = K2_P3_L_1_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
              }
            } // end of "p_step_l_2"-loop
            #endif
            // phase 2: process extra private iterations in dimension L_2 with all FUs
            #if K2_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2 > 0
            {  
              const size_t p_step_l_2 = K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2;
              {
                size_t p_iteration_l_1 = 0;
                for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2; ++p_iteration_l_2)
                  K2_PP3_L_1_P_KERNEL_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) = K2_P3_L_1_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
              }
            }
            #endif
            // phase 3: process extra private elements in dimension L_2 with a subset of all FUs
            #if K2_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_L_2 > 0
            if (K2_L_FU_ID_L_2 < (K2_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_L_2 + K2_P_NUM_FU_L_2 - 1) / K2_P_NUM_FU_L_2) {  
              // set step variable for access to res buffer
              const size_t p_step_l_2 = K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2 + (K2_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2 > 0);
              {
                size_t p_iteration_l_1 = 0;
                {
                  size_t p_iteration_l_2 = 0;
                  K2_PP3_L_1_P3_IN_COMPLETE_G_CB_L_2_P_KERNEL_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) = K2_P3_L_1_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
                }
              }
            }
            #endif
          }
        
        }
        #else
        #if K2_L_NUM_FU_R_1 == 1
          #if L_CB_RES_DEST_LEVEL <= LOCAL && CACHE_L_CB == 0
          barrier(CLK_LOCAL_MEM_FENCE);
          #elif L_CB_RES_DEST_LEVEL == GLOBAL
          barrier(CLK_GLOBAL_MEM_FENCE);
          #endif
        #endif
        for (size_t step = 0; step < (((((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) <= 0) * 0) + (((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) > 0) * ((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) <= K2_L_NUM_FU_L_1) * (K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1)) + (((K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) > K2_L_NUM_FU_L_1) * K2_L_NUM_FU_L_1)) * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2) / K2_L_FLAT_NUM_WI; ++step) {
          const size_t flat_index = K2_L_FLAT_WI_ID + step * K2_L_FLAT_NUM_WI;
          #if K2_G_NUM_FU_R_1 == 1
          const size_t l_index_l_1 = flat_index / (K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2);
          const size_t l_index_l_2 = flat_index % K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_L_2;
