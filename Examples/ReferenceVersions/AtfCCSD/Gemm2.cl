                const size_t BUFFER_INT_RES_INDEX_1(p_index_l_1, p_index_l_2, p_index_r_1) = (flat_index / (BUFFER_INT_RES_INDEX_0(1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, 1))) % BUFFER_INT_RES_INDEX_1(1, K2_P_NUM_PROCESSED_ELEMENTS_L_2, 1);
