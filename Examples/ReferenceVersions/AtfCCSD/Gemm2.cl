                const size_t flat_index = K2_P_FLAT_WI_ID + (((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_L_2 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_L_2 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
                #if CACHE_L_CB != 0
                const size_t BUFFER_INT_RES_INDEX_2(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index / (BUFFER_INT_RES_INDEX_1(1, 1, 1) * BUFFER_INT_RES_INDEX_0(1, 1, 1));
                const size_t BUFFER_INT_RES_INDEX_1(p_index_l_1, p_index_l_2, p_index_r_1) = (flat_index / (BUFFER_INT_RES_INDEX_0(1, 1, 1))) % BUFFER_INT_RES_INDEX_1(1, 1, 1);
                const size_t BUFFER_INT_RES_INDEX_0(p_index_l_1, p_index_l_2, p_index_r_1) = flat_index % BUFFER_INT_RES_INDEX_0(1, 1, 1);
                #else
                const size_t p_index_l_1 = flat_index / (1 * 1);
                const size_t p_index_l_2 = (flat_index / (1)) % 1;
                const size_t p_index_r_1 = flat_index % 1;
                #endif
                K2_P3_IN_COMPLETE_G_CB_L_1_P3_IN_COMPLETE_G_CB_L_2_PP3_R_1_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_P3_R_1_L_MEM_INT_RES(K2_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_1(p_index_l_1), K2_P3_P_TO_L_INDEX_IN_COMPLETE_G_CB_L_2(p_index_l_2), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
              }
              #endif
              // ---------- end of P caching -------------
              
              #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL
              {
                size_t p_iteration_l_1 = 0;
                {
                  size_t p_iteration_l_2 = 0;
                  size_t p_iteration_r_1 = 0;
                  // process one mda element
                  K2_P3_IN_COMPLETE_G_CB_L_1_P3_IN_COMPLETE_G_CB_L_2_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) = K2_P3_IN_COMPLETE_G_CB_L_1_P3_IN_COMPLETE_G_CB_L_2_PP3_R_1_P_MEM_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
                  
                
                }
              }
              #else
              {
                size_t p_iteration_l_1 = 0;
                {
                  size_t p_iteration_l_2 = 0;
                  {
                    size_t p_iteration_r_1 = 0;
                    // process one mda element
                    K2_P3_IN_COMPLETE_G_CB_L_1_P3_IN_COMPLETE_G_CB_L_2_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) += K2_P3_IN_COMPLETE_G_CB_L_1_P3_IN_COMPLETE_G_CB_L_2_PP3_R_1_P_MEM_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
                  
                  }
                }
              }
              #endif
            
              // ---------- reduction --------------------
              // will never be necessary on this level
              // because K2_P_NUM_FU_R == 1 for OpenCL
              // ---------- end of reduction -------------
            
              // move results upwards in memory hierarchy
              #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL || K2_P_NUM_FU_R_1 > 1
              #if 1 == 0 && 0 == 0 && 0 > 0
              if (K2_L_FU_ID_R_1 < (0 + K2_P_NUM_FU_R_1 - 1) / K2_P_NUM_FU_R_1)
              #endif
              {
                
                {
                  size_t p_iteration_l_1 = 0;
                  {
                    size_t p_iteration_l_2 = 0;
                    K2_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) += K2_P3_IN_COMPLETE_G_CB_L_1_P3_IN_COMPLETE_G_CB_L_2_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
                  }
                }
              }
              #endif
            
            }
          
          }
          #endif
        }
        #endif
        
        // wait for all WIs to finish computation on local cache block
        #if CACHE_L_CB != 0
        barrier(CLK_LOCAL_MEM_FENCE);
        #endif  
        #endif
      }
      #endif
      
      #if K2_L_NUM_FU_R_1 > 1
      #if K2_L_NUM_STEPS_R_1 == 0 && K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K2_L_NUM_EXTRA_ELEMENTS_R_1 > 0
      if (K2_G_FU_ID_R_1 < (K2_L_NUM_EXTRA_ELEMENTS_R_1 + K2_L_NUM_FU_R_1 - 1) / K2_L_NUM_FU_R_1)
      #endif
      {
        // wait for all FUs to finish computation
        #if   L_CB_RES_DEST_LEVEL == LOCAL && CACHE_L_CB == 0
        barrier(CLK_LOCAL_MEM_FENCE);
        #elif L_CB_RES_DEST_LEVEL == GLOBAL
        barrier(CLK_GLOBAL_MEM_FENCE);
        #endif
        #if L_CB_RES_DEST_LEVEL < LOCAL
        // phase 1: process private cached iterations in dimension L_1 with all FUs
        #if K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_1 > 0
        for (size_t p_step_l_1 = 0; p_step_l_1 < K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_1; ++p_step_l_1) {
          // phase 1: process private cached iterations in dimension L_2 with all FUs
          #if K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2 > 0
          for (size_t p_step_l_2 = 0; p_step_l_2 < K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2; ++p_step_l_2) {
            for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
              for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K2_P_NUM_CACHED_ITERATIONS_L_2; ++p_iteration_l_2) {
                K2_L_REDUCTION_MEM(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1) = K2_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
              }
            }
          } // end of "p_step_l_2"-loop
          #endif
          // phase 2: process extra private iterations in dimension L_2 with all FUs
          #if K2_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2 > 0
          {  
            const size_t p_step_l_2 = K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2;
            for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
              for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2; ++p_iteration_l_2) {
                K2_L_REDUCTION_MEM(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1) = K2_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
              }
            }
          }
          #endif
          // phase 3: process extra private elements in dimension L_2 with a subset of all FUs
          #if K2_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_L_2 > 0
          if (K2_L_FU_ID_L_2 < (K2_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_L_2 + K2_P_NUM_FU_L_2 - 1) / K2_P_NUM_FU_L_2) {  
            // set step variable for access to res buffer
            const size_t p_step_l_2 = K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2 + (K2_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2 > 0);
            for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
              {
                size_t p_iteration_l_2 = 0;
                K2_L_REDUCTION_MEM(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1) = K2_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
              }
            }
          }
          #endif
        } // end of "p_step_l_1"-loop
        #endif
        // phase 2: process extra private iterations in dimension L_1 with all FUs
        #if K2_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_1 > 0
        {  
          const size_t p_step_l_1 = K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_1;
          // phase 1: process private cached iterations in dimension L_2 with all FUs
          #if K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2 > 0
          for (size_t p_step_l_2 = 0; p_step_l_2 < K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2; ++p_step_l_2) {
            for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_1; ++p_iteration_l_1) {
              for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K2_P_NUM_CACHED_ITERATIONS_L_2; ++p_iteration_l_2) {
                K2_L_REDUCTION_MEM(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1) = K2_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
              }
            }
          } // end of "p_step_l_2"-loop
          #endif
          // phase 2: process extra private iterations in dimension L_2 with all FUs
          #if K2_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2 > 0
          {  
            const size_t p_step_l_2 = K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2;
            for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_1; ++p_iteration_l_1) {
              for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2; ++p_iteration_l_2) {
                K2_L_REDUCTION_MEM(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1) = K2_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
              }
            }
          }
          #endif
          // phase 3: process extra private elements in dimension L_2 with a subset of all FUs
          #if K2_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_L_2 > 0
          if (K2_L_FU_ID_L_2 < (K2_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_L_2 + K2_P_NUM_FU_L_2 - 1) / K2_P_NUM_FU_L_2) {  
            // set step variable for access to res buffer
            const size_t p_step_l_2 = K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2 + (K2_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2 > 0);
            for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_1; ++p_iteration_l_1) {
              {
                size_t p_iteration_l_2 = 0;
                K2_L_REDUCTION_MEM(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1) = K2_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
              }
            }
          }
          #endif
        }
        #endif
        // phase 3: process extra private elements in dimension L_1 with a subset of all FUs
        #if K2_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_L_1 > 0
        if (K2_L_FU_ID_L_1 < (K2_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_L_1 + K2_P_NUM_FU_L_1 - 1) / K2_P_NUM_FU_L_1) {  
          // set step variable for access to res buffer
          const size_t p_step_l_1 = K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_1 + (K2_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_1 > 0);
          // phase 1: process private cached iterations in dimension L_2 with all FUs
          #if K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2 > 0
          for (size_t p_step_l_2 = 0; p_step_l_2 < K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2; ++p_step_l_2) {
            {
              size_t p_iteration_l_1 = 0;
              for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K2_P_NUM_CACHED_ITERATIONS_L_2; ++p_iteration_l_2) {
                K2_L_REDUCTION_MEM(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1) = K2_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
              }
            }
          } // end of "p_step_l_2"-loop
          #endif
          // phase 2: process extra private iterations in dimension L_2 with all FUs
          #if K2_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2 > 0
          {  
            const size_t p_step_l_2 = K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2;
            {
              size_t p_iteration_l_1 = 0;
              for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2; ++p_iteration_l_2) {
                K2_L_REDUCTION_MEM(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1) = K2_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
              }
            }
          }
          #endif
          // phase 3: process extra private elements in dimension L_2 with a subset of all FUs
          #if K2_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_L_2 > 0
          if (K2_L_FU_ID_L_2 < (K2_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_L_2 + K2_P_NUM_FU_L_2 - 1) / K2_P_NUM_FU_L_2) {  
            // set step variable for access to res buffer
            const size_t p_step_l_2 = K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2 + (K2_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2 > 0);
            {
              size_t p_iteration_l_1 = 0;
              {
                size_t p_iteration_l_2 = 0;
                K2_L_REDUCTION_MEM(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1) = K2_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
              }
            }
          }
          #endif
        }
        #endif
        // wait for all values to be copied into reduction memory
        barrier(CLK_LOCAL_MEM_FENCE);
        #endif
        #if (K2_L_NUM_FU_R_1 & (K2_L_NUM_FU_R_1 - 1)) != 0
        // pre processing: reduce number of values to largest possible power of 2
        size_t stride = pow(2.0f, floor(log2((float) K2_L_NUM_FU_R_1)));
        if (K2_L_FU_ID_R_1 < stride && K2_L_FU_ID_R_1 + stride < K2_L_NUM_FU_R_1) {
          // phase 1: process private cached iterations in dimension L_1 with all FUs
          #if K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_1 > 0
          for (size_t p_step_l_1 = 0; p_step_l_1 < K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_1; ++p_step_l_1) {
            // phase 1: process private cached iterations in dimension L_2 with all FUs
            #if K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2 > 0
            for (size_t p_step_l_2 = 0; p_step_l_2 < K2_P_NUM_STEPS_IN_COMPLETE_G_CB_L_2; ++p_step_l_2) {
              for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
                for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K2_P_NUM_CACHED_ITERATIONS_L_2; ++p_iteration_l_2) {
                  #if L_CB_RES_DEST_LEVEL < LOCAL
                  // reduction in separate memory location
                  K2_L_REDUCTION_MEM(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1) += K2_L_REDUCTION_MEM(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1 + stride);
                  #elif L_CB_RES_DEST_LEVEL == LOCAL
                  K2_RES_L_BUFFER(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1, K2_P_FU_ID_R_1) += K2_RES_L_BUFFER(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)), K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1);
                  #elif L_CB_RES_DEST_LEVEL == GLOBAL
                  K2_RES_G_BUFFER(K2_L_TO_G_INDEX_L_1(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_L_TO_G_INDEX_L_2(K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1, K2_P_FU_ID_R_1) += K2_RES_G_BUFFER(K2_L_TO_G_INDEX_L_1(K2_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_L_TO_G_INDEX_L_2(K2_P_TO_L_INDEX_L_2(K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1);
                  #endif
                
                }
              }
            } // end of "p_step_l_2"-loop
            #endif
            // phase 2: process extra private iterations in dimension L_2 with all FUs
            #if K2_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_L_2 > 0
