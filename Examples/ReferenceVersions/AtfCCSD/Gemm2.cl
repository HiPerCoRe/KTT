                const size_t p_index_l_2 = (flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_R_1)) % 1;
                const size_t p_index_r_1 = flat_index % K2_P_NUM_PROCESSED_ELEMENTS_R_1;
                #endif
                K2_P3_L_1_PP3_L_2_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_P3_L_2_L_MEM_INT_RES(K2_P3_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_L_2(p_index_l_2), K2_P_TO_L_INDEX_R_1(p_index_r_1));
