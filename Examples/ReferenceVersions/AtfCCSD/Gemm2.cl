                    K2_P3_L_1_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) += K2_PP3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2));
                }
              }
              #endif
            
            }
          
          }
          #endif
          // phase 3: process extra private elements in dimension L_2 with a subset of all FUs
          #if K2_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_L_2 > 0
          if (K2_L_FU_ID_L_2 < (K2_P_NUM_EXTRA_ELEMENTS_IN_COMPLETE_G_CB_L_2 + K2_P_NUM_FU_L_2 - 1) / K2_P_NUM_FU_L_2) {  
