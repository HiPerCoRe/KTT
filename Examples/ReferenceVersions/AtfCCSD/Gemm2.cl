              {
                size_t p_iteration_l_1 = 0;
                {
                  size_t p_iteration_l_2 = 0;
                  size_t p_iteration_r_1 = 0;
                  // process one mda element
                  K2_PP3_L_1_P3_IN_COMPLETE_G_CB_L_2_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) = K2_PP3_L_1_P3_IN_COMPLETE_G_CB_L_2_PP3_R_1_P_MEM_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
                  
                
