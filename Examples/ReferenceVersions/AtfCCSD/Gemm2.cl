              const size_t p_index_l_2 = (flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_R_1)) % K2_P_NUM_PROCESSED_ELEMENTS_L_2;
              const size_t p_index_r_1 = flat_index % K2_P_NUM_PROCESSED_ELEMENTS_R_1;
              #endif
              K2_PP3_L_1_P_MEM_INT_RES(p_index_l_1, p_index_l_2, p_index_r_1) = K2_P3_L_1_L_MEM_INT_RES(K2_PP3_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_L_2(p_index_l_2), K2_P_TO_L_INDEX_R_1(p_index_r_1));
            }
            #endif
            #endif
            // ---------- end of P caching -------------
            
            #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL
            {
              size_t p_iteration_l_1 = 0;
              for (size_t p_iteration_l_2 = 0; p_iteration_l_2 < K2_P_NUM_CACHED_ITERATIONS_L_2; ++p_iteration_l_2) {
                size_t p_iteration_r_1 = 0;
                // process one mda element
                K2_PP3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2)) = K2_PP3_L_1_P_MEM_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_L_2(p_iteration_l_2), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
                
                #if K2_P_NUM_CACHED_ITERATIONS_R_1 > 1
