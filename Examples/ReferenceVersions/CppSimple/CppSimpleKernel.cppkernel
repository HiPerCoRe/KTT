// Simple C++ kernel for vector addition with tuning parameter
// Signature matches void (*)(void**, size_t*)
// buffers[0] = output float*
// buffers[1] = inputA float*
// buffers[2] = inputB float*
// sizes[0] = number of elements (in bytes)
#include <cstddef>

// UNROLL_FACTOR is defined via compiler flags from tuning parameter
#ifndef UNROLL_FACTOR
#define UNROLL_FACTOR 1
#endif

extern "C" void vectorAdd(void** buffers, size_t* sizes) {
    size_t byteSize = sizes[0];
    size_t count = byteSize / sizeof(float);
    float* out = static_cast<float*>(buffers[0]);
    const float* a = static_cast<const float*>(buffers[1]);
    const float* b = static_cast<const float*>(buffers[2]);
    
    size_t i = 0;
    
    // Main loop with unrolling
    for (; i + UNROLL_FACTOR <= count; i += UNROLL_FACTOR) {
        #if UNROLL_FACTOR >= 1
        out[i] = a[i] + b[i];
        #endif
        #if UNROLL_FACTOR >= 2
        out[i+1] = a[i+1] + b[i+1];
        #endif
        #if UNROLL_FACTOR >= 4
        out[i+2] = a[i+2] + b[i+2];
        out[i+3] = a[i+3] + b[i+3];
        #endif
        #if UNROLL_FACTOR >= 8
        out[i+4] = a[i+4] + b[i+4];
        out[i+5] = a[i+5] + b[i+5];
        out[i+6] = a[i+6] + b[i+6];
        out[i+7] = a[i+7] + b[i+7];
        #endif
        #if UNROLL_FACTOR >= 16
        out[i+8] = a[i+8] + b[i+8];
        out[i+9] = a[i+9] + b[i+9];
        out[i+10] = a[i+10] + b[i+10];
        out[i+11] = a[i+11] + b[i+11];
        out[i+12] = a[i+12] + b[i+12];
        out[i+13] = a[i+13] + b[i+13];
        out[i+14] = a[i+14] + b[i+14];
        out[i+15] = a[i+15] + b[i+15];
        #endif
    }
    
    // Handle remaining elements
    for (; i < count; ++i) {
        out[i] = a[i] + b[i];
    }
}
