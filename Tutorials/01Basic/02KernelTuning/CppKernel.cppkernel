#include <cstddef>
#include <cstdint>
#include <cstring>

extern "C" void vectorAddition(void **buffers, size_t *sizes)
{
    // Get element count from first vector argument's size.
    // !NOTE! the need for division by sizeof(float)
    size_t count = sizes[0] / sizeof(float);

    // Access vector arguments
    const float* a = static_cast<const float*>(buffers[0]);
    const float* b = static_cast<const float*>(buffers[1]);
    float* result = static_cast<float*>(buffers[2]);

    // Reinterpret the size_t scalar value as float
    // The scalar was passed as size_t (64-bit), but contains the bit pattern of a float (32-bit)
    // We take the lower 32 bits and reinterpret them as float
    uint32_t scalar_bits = static_cast<uint32_t>(sizes[3] & 0xFFFFFFFF);
    float scalar;
    static_assert(sizeof(scalar) == sizeof(scalar_bits), "Size mismatch");
    memcpy(&scalar, &scalar_bits, sizeof(float));

    // The tuning parameter is added to the beginning of this file as a preprocessor
    // definition, e.g., as "#define OMP_SCHEDULING 1" for a parameter value of 1.
    #if OMP_SCHEDULING == 0
    #pragma omp parallel for schedule(static)
    #else
    #pragma omp parallel for schedule(dynamic)
    #endif
    // Perform vector addition
    for (size_t i = 0; i < count; ++i) {
        result[i] = a[i] + b[i] + scalar;
    }
}